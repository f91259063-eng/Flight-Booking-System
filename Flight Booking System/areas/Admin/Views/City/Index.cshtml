
@model IEnumerable<Flight_Booking_System.Models.city>

@{
    ViewData["Title"] = "Cities";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="ltr">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Cities</h2>
            <p class="text-muted mb-0">
                Manage the cities available in the flight booking system.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="City"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Create New City
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Cities List</h5>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead style="background-color: #0b1729; color: white;">
                        <tr>
                            <th>City Name</th>
                            <th class="text-center" style="width: 250px;">
                                Actions
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var city in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @city.Name
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-2">

                                            <a asp-area="Admin"
                                               asp-controller="City"
                                               asp-action="Edit"
                                               asp-route-id="@city.Id"
                                               class="btn btn-warning btn-sm">
                                                Edit
                                            </a>

                                            <a asp-area="Admin"
                                               asp-controller="City"
                                               asp-action="Delete"
                                               asp-route-id="@city.Id"
                                               class="btn btn-danger btn-sm">
                                                Delete
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2"
                                    class="text-center py-4 text-muted">
                                    No cities found.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>
</div>

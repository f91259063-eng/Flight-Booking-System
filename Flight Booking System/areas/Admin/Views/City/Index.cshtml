@model IEnumerable<Flight_Booking_System.Models.city>

@{
    ViewData["Title"] = "Cities";
    Layout = "_AdminLayout";

    var cities = Model?.ToList() ?? new List<Flight_Booking_System.Models.city>();
    var totalCities = cities.Count;
}

<div class="container-fluid py-4 airline-management" dir="ltr">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="text-primary fw-semibold small text-uppercase">
                Location Management
            </span>
            <h2 class="fw-bold mb-1">Cities</h2>
            <p class="text-muted mb-0">
                Manage the cities available in the flight booking system.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="City"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add New City
        </a>
    </div>

    <!-- Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm airline-stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="airline-table-icon">
                        <i class="bi bi-buildings"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-1">Total Cities</p>
                        <h4 class="fw-bold mb-0">@totalCities</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm airline-stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="airline-table-icon">
                        <i class="bi bi-geo-alt"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-1">Registered Cities</p>
                        <h4 class="fw-bold mb-0">@totalCities</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm airline-stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="airline-table-icon">
                        <i class="bi bi-list-ul"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-1">City Directory</p>
                        <h6 class="fw-bold mb-0">Manage Cities</h6>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Cities Table -->
    <div class="card border-0 shadow-sm flight-table-card">

        <div class="card-header bg-white py-3 px-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div>
                    <h5 class="fw-bold mb-1">Cities Directory</h5>
                    <p class="text-muted small mb-0">
                        View and manage all registered cities.
                    </p>
                </div>

                <div class="position-relative" style="width: min(100%, 280px);">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="search"
                           id="citySearch"
                           class="form-control ps-5"
                           placeholder="Search cities..."
                           aria-label="Search cities" />
                </div>

            </div>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 flight-table">

                    <thead>
                        <tr>
                            <th class="ps-4">City Name</th>
                            <th class="text-center" style="width: 220px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody id="citiesTableBody">

                        @if (cities.Any())
                        {
                            foreach (var city in cities)
                            {
                                <tr class="city-row">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="airline-table-icon">
                                                <i class="bi bi-geo-alt"></i>
                                            </div>
                                            <span class="fw-semibold city-name">
                                                @city.Name
                                            </span>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-2 flex-wrap">

                                            <a asp-area="Admin"
                                               asp-controller="City"
                                               asp-action="Edit"
                                               asp-route-id="@city.Id"
                                               class="flight-action-btn btn-outline-primary">
                                                <i class="bi bi-pencil-square"></i>
                                                <span>Edit</span>
                                            </a>

                                            <a asp-area="Admin"
                                               asp-controller="City"
                                               asp-action="Delete"
                                               asp-route-id="@city.Id"
                                               class="flight-action-btn btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                                <span>Delete</span>
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2" class="text-center py-5 text-muted">
                                    <i class="bi bi-geo-alt fs-2 d-block mb-2"></i>
                                    No cities found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            </div>

            <!-- Search Empty State -->
            <div id="cityNoResults"
                 class="text-center py-5 text-muted d-none">
                <i class="bi bi-search fs-2 d-block mb-2"></i>
                No matching cities found.
            </div>

        </div>

        <div class="card-footer bg-white border-0 px-4 py-3">
            <small class="text-muted">
                Showing <strong id="visibleCityCount">@totalCities</strong>
                of <strong>@totalCities</strong> cities
            </small>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchElement = document.getElementById("citySearch");
            const tableBody = document.getElementById("citiesTableBody");
            const noResults = document.getElementById("cityNoResults");
            const visibleCount = document.getElementById("visibleCityCount");

            if (!(searchElement instanceof HTMLInputElement)) return;
            if (!(tableBody instanceof HTMLTableSectionElement)) return;
            if (!(noResults instanceof HTMLElement)) return;
            if (!(visibleCount instanceof HTMLElement)) return;

            const rows = tableBody.querySelectorAll(".city-row");

            function filterCities() {

                const searchValue = searchElement.value.trim().toLowerCase();
                let visibleRows = 0;

                rows.forEach(function (row) {

                    if (!(row instanceof HTMLTableRowElement)) return;

                    const cityName = row.querySelector(".city-name");

                    const name = cityName?.textContent?.trim().toLowerCase() ?? "";

                    const matches = name.includes(searchValue);

                    row.style.display = matches ? "" : "none";

                    if (matches) {
                        visibleRows++;
                    }
                });

                visibleCount.textContent = visibleRows.toString();

                noResults.classList.toggle("d-none", visibleRows !== 0);
            }

            searchElement.addEventListener("input", filterCities);

        });
    </script>
}

@model Flight_Booking_System.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Overview";
    Layout = "_AdminLayout";

    var chartItems = new[]
    {
        new { Label = "Flights", Value = Model.TotalFlights, Color = "#0891b2" },
        new { Label = "Bookings", Value = Model.TotalBookings, Color = "#2563eb" },
        new { Label = "Passengers", Value = Model.TotalPassengers, Color = "#16a34a" },
        new { Label = "Aircraft", Value = Model.TotalAircraft, Color = "#7c3aed" },
        new { Label = "Airports", Value = Model.TotalAirports, Color = "#ea580c" },
        new { Label = "Routes", Value = Model.TotalRoutes, Color = "#db2777" }
    };
    var maxChartValue = Math.Max(1, chartItems.Max(x => x.Value));
}

<div class="admin-dashboard-welcome">
    <div>
        <div class="admin-eyebrow text-white-50 mb-2">Flight Booking System</div>
        <h1>Welcome to your control center</h1>
        <p>Monitor your airline operations, manage resources, and review system activity.</p>
    </div>
    <div class="welcome-icon" aria-hidden="true">
        <i class="fas fa-plane-departure"></i>
    </div>
</div>

<div class="admin-section-heading">
    <h2>System Overview</h2>
    <span>Live totals from your database</span>
</div>

<div class="admin-stats-grid">
    <article class="admin-stat-card stat-blue">
        <div class="admin-stat-top">
            <span class="admin-stat-label">Total Users</span>
            <span class="admin-stat-icon"><i class="fas fa-users"></i></span>
        </div>
        <div class="admin-stat-value">@Model.TotalUsers.ToString("N0")</div>
        <div class="admin-stat-foot">Registered system accounts</div>
    </article>

    <article class="admin-stat-card stat-cyan">
        <div class="admin-stat-top">
            <span class="admin-stat-label">Total Flights</span>
            <span class="admin-stat-icon"><i class="fas fa-plane"></i></span>
        </div>
        <div class="admin-stat-value">@Model.TotalFlights.ToString("N0")</div>
        <div class="admin-stat-foot">Flights in the system</div>
    </article>

    <article class="admin-stat-card stat-green">
        <div class="admin-stat-top">
            <span class="admin-stat-label">Total Bookings</span>
            <span class="admin-stat-icon"><i class="fas fa-ticket-alt"></i></span>
        </div>
        <div class="admin-stat-value">@Model.TotalBookings.ToString("N0")</div>
        <div class="admin-stat-foot">Booking records</div>
    </article>

    <article class="admin-stat-card stat-violet">
        <div class="admin-stat-top">
            <span class="admin-stat-label">Total Passengers</span>
            <span class="admin-stat-icon"><i class="fas fa-user-friends"></i></span>
        </div>
        <div class="admin-stat-value">@Model.TotalPassengers.ToString("N0")</div>
        <div class="admin-stat-foot">Passenger profiles</div>
    </article>

    <article class="admin-stat-card stat-orange">
        <div class="admin-stat-top">
            <span class="admin-stat-label">Aircraft</span>
            <span class="admin-stat-icon"><i class="fas fa-plane"></i></span>
        </div>
        <div class="admin-stat-value">@Model.TotalAircraft.ToString("N0")</div>
        <div class="admin-stat-foot">Registered aircraft</div>
    </article>

    <article class="admin-stat-card stat-rose">
        <div class="admin-stat-top">
            <span class="admin-stat-label">Airports</span>
            <span class="admin-stat-icon"><i class="fas fa-map-marker-alt"></i></span>
        </div>
        <div class="admin-stat-value">@Model.TotalAirports.ToString("N0")</div>
        <div class="admin-stat-foot">Airport locations</div>
    </article>

    <article class="admin-stat-card stat-cyan">
        <div class="admin-stat-top">
            <span class="admin-stat-label">Routes</span>
            <span class="admin-stat-icon"><i class="fas fa-route"></i></span>
        </div>
        <div class="admin-stat-value">@Model.TotalRoutes.ToString("N0")</div>
        <div class="admin-stat-foot">Available flight routes</div>
    </article>

    <article class="admin-stat-card stat-green">
        <div class="admin-stat-top">
            <span class="admin-stat-label">Total Seats</span>
            <span class="admin-stat-icon"><i class="fas fa-chair"></i></span>
        </div>
        <div class="admin-stat-value">@Model.TotalSeats.ToString("N0")</div>
        <div class="admin-stat-foot">Configured aircraft seats</div>
    </article>
</div>

<div class="admin-dashboard-grid">
    <section class="admin-panel">
        <div class="admin-panel-header">
            <div>
                <h2 class="admin-panel-title">System Data Distribution</h2>
                <p class="admin-panel-subtitle">A quick comparison of the main operational records</p>
            </div>
            <span class="admin-eyebrow">Overview</span>
        </div>

        <div class="d-grid gap-3">
            @foreach (var item in chartItems)
            {
                var percentage = Math.Round((double)item.Value / maxChartValue * 100);
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-semibold">@item.Label</span>
                        <strong class="small">@item.Value.ToString("N0")</strong>
                    </div>
                    <div class="progress" style="height:9px; background:#edf2f7; border-radius:20px;">
                        <div class="progress-bar" role="progressbar"
                             style="width:@percentage%; background-color:@item.Color; border-radius:20px;"
                             aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="admin-panel">
        <div class="admin-panel-header">
            <div>
                <h2 class="admin-panel-title">System Summary</h2>
                <p class="admin-panel-subtitle">Additional platform totals</p>
            </div>
            <i class="fas fa-chart-pie admin-muted"></i>
        </div>

        <ul class="admin-summary-list">
            <li><span><i class="fas fa-user-tag me-2"></i>Roles</span><strong>@Model.TotalRoles.ToString("N0")</strong></li>
            <li><span><i class="fas fa-credit-card me-2"></i>Payments</span><strong>@Model.TotalPayments.ToString("N0")</strong></li>
            <li><span><i class="fas fa-city me-2"></i>Cities</span><strong>@Model.TotalCities.ToString("N0")</strong></li>
            <li><span><i class="fas fa-plane me-2"></i>Aircraft</span><strong>@Model.TotalAircraft.ToString("N0")</strong></li>
            <li><span><i class="fas fa-map-marked-alt me-2"></i>Airports</span><strong>@Model.TotalAirports.ToString("N0")</strong></li>
        </ul>
    </section>
</div>

<div class="admin-section-heading">
    <h2>Quick Actions</h2>
    <span>Shortcuts to common tasks</span>
</div>

<div class="admin-quick-actions">
    <a class="admin-quick-action" asp-area="Admin" asp-controller="Flight" asp-action="Create">
        <i class="fas fa-plus"></i>
        <span><strong>Create Flight</strong><small>Add a new flight</small></span>
    </a>
    <a class="admin-quick-action" asp-area="Admin" asp-controller="Airports" asp-action="Create">
        <i class="fas fa-map-marker-alt"></i>
        <span><strong>Add Airport</strong><small>Register an airport</small></span>
    </a>
    <a class="admin-quick-action" asp-area="Admin" asp-controller="Routes" asp-action="Create">
        <i class="fas fa-route"></i>
        <span><strong>Create Route</strong><small>Connect two airports</small></span>
    </a>
    <a class="admin-quick-action" asp-area="Admin" asp-controller="Admin" asp-action="Users">
        <i class="fas fa-user-cog"></i>
        <span><strong>Manage Users</strong><small>Review system accounts</small></span>
    </a>
</div>

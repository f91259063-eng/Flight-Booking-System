<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Admin Dashboard") | Flight Booking System</title>

    <link rel="icon" type="image/png" href="~/assets/img/favicons/favicon-32x32.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/vendors/fontawesome/all.min.css" />

    <link rel="stylesheet" href="~/css/admin/admin-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin-responsive.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-app">
    <div class="admin-shell">
        <aside class="admin-sidebar" data-admin-sidebar aria-label="Admin navigation">
            <a class="admin-brand" asp-area="Admin" asp-controller="Home" asp-action="Index">
                <span class="admin-brand-mark"><i class="fas fa-plane-departure"></i></span>
                <span>
                    <span class="admin-brand-name">Flight Booking</span>
                    <span class="admin-brand-caption">Administration</span>
                </span>
            </a>

            <div class="admin-sidebar-scroll">
                <div class="admin-nav-group">
                    <div class="admin-nav-heading">Dashboard</div>
                    <a class="admin-nav-link" asp-area="Admin" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-chart-pie"></i><span>Overview</span>
                    </a>
                </div>

                <div class="admin-nav-group">
                    <div class="admin-nav-heading">Location Management</div>
                    <a class="admin-nav-link" asp-area="Admin" asp-controller="city" asp-action="Index"><i class="fas fa-city"></i><span>Cities</span></a>
                    <a class="admin-nav-link" asp-area="Admin" asp-controller="Airports" asp-action="Index"><i class="fas fa-plane-arrival"></i><span>Airports</span></a>
                    <a class="admin-nav-link" asp-area="Admin" asp-controller="Routes" asp-action="Index"><i class="fas fa-route"></i><span>Routes</span></a>
                </div>

                <div class="admin-nav-group">
                    <div class="admin-nav-heading">Aircraft Management</div>
                    <a class="admin-nav-link" asp-area="Admin" asp-controller="Airline" asp-action="Index"><i class="fas fa-building"></i><span>Airlines</span></a>
                    <a class="admin-nav-link" asp-area="Admin" asp-controller="Aircraft" asp-action="Index"><i class="fas fa-plane"></i><span>Aircraft</span></a>
                    <a class="admin-nav-link" asp-area="Admin" asp-controller="Class" asp-action="Index"><i class="fas fa-layer-group"></i><span>Classes</span></a>
                    <a class="admin-nav-link" asp-area="Admin" asp-controller="AircraftClasses" asp-action="Index"><i class="fas fa-chair"></i><span>Aircraft Classes &amp; Seats</span></a>
                </div>

                <div class="admin-nav-group">
                    <div class="admin-nav-heading">Flight Operations</div>
                    <a class="admin-nav-link" asp-area="Admin" asp-controller="Flight" asp-action="Index"><i class="fas fa-plane-departure"></i><span>Flights</span></a>
                </div>

                <div class="admin-nav-group">
                    <div class="admin-nav-heading">Booking Management</div>
                    <a class="admin-nav-link" asp-area="Admin" asp-controller="Bookings" asp-action="Index"><i class="fas fa-ticket-alt"></i><span>Bookings</span></a>
                    <a class="admin-nav-link" asp-area="Admin" asp-controller="Passengers" asp-action="Index"><i class="fas fa-users"></i><span>Passengers</span></a>
                </div>

                <div class="admin-nav-group">
                    <div class="admin-nav-heading">Security &amp; Access</div>
                    <a class="admin-nav-link" asp-area="Admin" asp-controller="Admin" asp-action="Users"><i class="fas fa-user-shield"></i><span>Users</span></a>
                    <a class="admin-nav-link" asp-area="Admin" asp-controller="Roles" asp-action="Index"><i class="fas fa-user-tag"></i><span>Roles</span></a>
                    <a class="admin-nav-link" asp-area="Admin" asp-controller="ActivityLog" asp-action="Index"><i class="fas fa-history"></i><span>Activity Logs</span></a>
                </div>
            </div>

            <div class="admin-sidebar-bottom">
                <div class="admin-sidebar-version">Flight Booking System · Admin Panel</div>
            </div>
        </aside>

        <div class="admin-sidebar-overlay" data-admin-sidebar-overlay></div>

        <main class="admin-main">
            <header class="admin-topbar">
                <div class="admin-topbar-start">
                    <button class="admin-menu-toggle" type="button" data-admin-sidebar-toggle
                            aria-label="Toggle navigation" aria-expanded="false">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1 class="admin-topbar-title">@((ViewData["Title"] ?? "Dashboard").ToString())</h1>
                </div>

                <div class="admin-topbar-end">
                    <label class="admin-search" aria-label="Search navigation">
                        <i class="fas fa-search"></i>
                        <input type="search" placeholder="Search menu..." data-admin-nav-search />
                    </label>

                    <a class="admin-icon-button" asp-area="Admin" asp-controller="Home" asp-action="Index"
                       title="Dashboard" aria-label="Dashboard">
                        <i class="fas fa-home"></i>
                    </a>

                    <div class="dropdown">
                        <button class="btn p-0 border-0 bg-transparent dropdown-toggle admin-user-menu"
                                type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="admin-user-avatar"><i class="fas fa-user"></i></span>
                            <span class="admin-user-meta text-start">
                                <span class="admin-user-name">Administrator</span>
                                <span class="admin-user-role">System Admin</span>
                            </span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow border-0 p-2">
                            <a class="dropdown-item rounded-2" asp-area="Admin" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-chart-pie me-2"></i>Dashboard
                            </a>
                            <div class="dropdown-divider"></div>
                            <form asp-area="Identity" asp-page="/Account/Logout"
                                  asp-route-returnUrl="/Identity/Account/Login" method="post">
                                <button type="submit" class="dropdown-item rounded-2 text-danger">
                                    <i class="fas fa-sign-out-alt me-2"></i>Logout
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <section class="admin-content">
                @RenderBody()
            </section>

            <footer class="admin-footer">
                <span>Flight Booking System &copy; @DateTime.Now.Year</span>
                <span>Administration Panel</span>
            </footer>
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin/admin-layout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

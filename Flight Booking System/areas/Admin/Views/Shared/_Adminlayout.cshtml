

<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @(ViewData["Title"] ?? "Admin Dashboard")
        | Flight Booking System
    </title>

    <!-- Favicon -->
    <link rel="icon"
          type="image/png"
          href="~/assets/img/favicons/favicon-32x32.png" />

    <!-- Falcon Configuration -->
    <script src="~/assets/js/config.js"></script>

    <!-- Simplebar CSS -->
    <link rel="stylesheet"
          href="~/vendors/simplebar/simplebar.min.css" />

    <!-- Falcon Theme CSS -->
    <link rel="stylesheet"
          href="~/assets/css/theme.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet"
          href="~/assets/css/user.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="~/vendors/fontawesome/all.min.css" />

    <style>
            .navbar-brand-text {
                font-size: 1.15rem;
                font-weight: 700;
                color: #2c7be5;
                white-space: nowrap;
            }

            .navbar-brand img {
                object-fit: contain;
            }

            .content {
                min-width: 0;
            }

            .sidebar-heading {
                padding: 12px 20px 5px;
                font-size: 11px;
                color: #748194;
                font-weight: 700;
                text-transform: uppercase;
            }

            .footer {
                margin-top: auto;
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <main class="main" id="top">

        <div class="container-fluid"
             data-layout="container">

            <!-- ========================= -->
            <!-- Sidebar -->
            <!-- ========================= -->

            <nav class="navbar navbar-light navbar-vertical navbar-expand-xl">

                <!-- Sidebar Header -->
                <div class="d-flex align-items-center">

                    <div class="toggle-icon-wrapper">
                        <button class="btn navbar-toggler-humburger-icon
                            navbar-vertical-toggle"
                                type="button"
                                data-bs-toggle="tooltip"
                                data-bs-placement="left"
                                title="Toggle Navigation">

                            <span class="navbar-toggle-icon">
                                <span class="toggle-line"></span>
                            </span>

                        </button>
                    </div>

                    <!-- Project Logo -->
                    <a class="navbar-brand"
                       asp-area="Admin"
                       asp-controller="Home"
                       asp-action="Index">

                        <div class="d-flex align-items-center py-3">

                            <img class="me-2"
                                 src="~/falcon/img/apple-touch-icon.png"
                                 alt="Flight Booking System Logo"
                                 width="40"
                                 height="40" />

                            <span class="navbar-brand-text">
                                Flight_Booking_System
                            </span>

                        </div>
                    </a>

                </div>

                <!-- Sidebar Menu -->
                <div class="collapse navbar-collapse"
                     id="navbarVerticalCollapse">

                    <div class="navbar-vertical-content scrollbar">

                        <ul class="navbar-nav flex-column mb-3"
                            id="navbarVerticalNav">

                            <!-- Dashboard -->
                            <li class="nav-item">

                                <a class="nav-link dropdown-indicator"
                                   href="#dashboardMenu"
                                   role="button"
                                   data-bs-toggle="collapse"
                                   aria-expanded="true"
                                   aria-controls="dashboardMenu">

                                    <div class="d-flex align-items-center">

                                        <span class="nav-link-icon">
                                            <i class="fas fa-chart-pie"></i>
                                        </span>

                                        <span class="nav-link-text ps-1">
                                            Dashboard
                                        </span>

                                    </div>

                                </a>

                                <div class="collapse show"
                                     id="dashboardMenu">

                                    <ul class="nav flex-column">

                                        <!-- Dashboard Home -->
                                        <li class="nav-item">
                                            <a class="nav-link"
                                               asp-area="Admin"
                                               asp-controller="Home"
                                               asp-action="Index">

                                                <div class="d-flex align-items-center">
                                                    <span class="nav-link-text ps-1">
                                                        Overview
                                                    </span>
                                                </div>

                                            </a>
                                        </li>

                                        <!-- Cities -->
                                        <li class="nav-item">
                                            <a class="nav-link"
                                               asp-area="Admin"
                                               asp-controller="city"
                                               asp-action="Index">

                                                <div class="d-flex align-items-center">
                                                    <span class="nav-link-text ps-1">
                                                        Cities
                                                    </span>
                                                </div>

                                            </a>
                                        </li>

                                        <!-- Routes -->
                                        <li class="nav-item">
                                            <a class="nav-link"
                                               asp-area="Admin"
                                               asp-controller="Routes"
                                               asp-action="Index">

                                                <div class="d-flex align-items-center">
                                                    <span class="nav-link-text ps-1">
                                                        Routes
                                                    </span>
                                                </div>

                                            </a>
                                        </li>

                                        <!-- Airports -->
                                        <li class="nav-item">
                                            <a class="nav-link"
                                               asp-area="Admin"
                                               asp-controller="Airports"
                                               asp-action="Index">

                                                <div class="d-flex align-items-center">
                                                    <span class="nav-link-text ps-1">
                                                        Airports
                                                    </span>
                                                </div>

                                            </a>
                                        </li>


                                        <!-- Class -->
                                        <li class="nav-item">
                                            <a class="nav-link"
                                               asp-area="Admin"
                                               asp-controller="Class"
                                               asp-action="Index">

                                                <div class="d-flex align-items-center">
                                                    <span class="nav-link-text ps-1">
                                                        Class
                                                    </span>
                                                </div>

                                            </a>
                                        </li>




                                        <!-- Airline -->
                                        <li class="nav-item">
                                            <a class="nav-link"
                                               asp-area="Admin"
                                               asp-controller="Airline"
                                               asp-action="Index">

                                                <div class="d-flex align-items-center">
                                                    <span class="nav-link-text ps-1">
                                                        Airline
                                                    </span>
                                                </div>

                                            </a>
                                        </li>


                                        <!-- Aircraft -->
                                        <li class="nav-item">
                                            <a class="nav-link"
                                               asp-area="Admin"
                                               asp-controller="Aircraft"
                                               asp-action="Index">

                                                <div class="d-flex align-items-center">
                                                    <span class="nav-link-text ps-1">
                                                        Aircraft
                                                    </span>
                                                </div>

                                            </a>
                                        </li>



                                    </ul>

                                </div>

                            </li>

                            <!-- Passenger -->
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area="Admin"
                                   asp-controller="Passenger"
                                   asp-action="Index">

                                    <div class="d-flex align-items-center">
                                        <span class="nav-link-text ps-1">
                                            Passenger
                                        </span>
                                    </div>

                                </a>
                            </li>





                        </ul>

                    </div>

                </li>

                            <!-- Flights Section -->
                            <li class="nav-item">

                                <div class="sidebar-heading">
                                    Flight Management
                                </div>

                                <a class="nav-link"
                                   asp-area="Admin"
                                   asp-controller="Flights"
                                   asp-action="Index">

                                    <div class="d-flex align-items-center">
                                        <span class="nav-link-icon">
                                            <i class="fas fa-plane"></i>
                                        </span>

                                        <span class="nav-link-text ps-1">
                                            Flights
                                        </span>
                                    </div>

                                </a>

                            </li>

                            <!-- Aircrafts -->
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area="Admin"
                                   asp-controller="Aircrafts"
                                   asp-action="Index">

                                    <div class="d-flex align-items-center">
                                        <span class="nav-link-icon">
                                            <i class="fas fa-plane-departure"></i>
                                        </span>

                                        <span class="nav-link-text ps-1">
                                            Aircrafts
                                        </span>
                                    </div>

                                </a>
                            </li>

                            <!-- Bookings -->
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area="Admin"
                                   asp-controller="Bookings"
                                   asp-action="Index">

                                    <div class="d-flex align-items-center">
                                        <span class="nav-link-icon">
                                            <i class="fas fa-ticket-alt"></i>
                                        </span>

                                        <span class="nav-link-text ps-1">
                                            Bookings
                                        </span>
                                    </div>

                                </a>
                            </li>

                            <!-- Passengers -->
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area="Admin"
                                   asp-controller="Passengers"
                                   asp-action="Index">

                                    <div class="d-flex align-items-center">
                                        <span class="nav-link-icon">
                                            <i class="fas fa-users"></i>
                                        </span>

                                        <span class="nav-link-text ps-1">
                                            Passengers
                                        </span>
                                    </div>

                                </a>
                            </li>

                            <!-- Identity Management -->
                            <li class="nav-item">

                                <div class="sidebar-heading">
                                    Security
                                </div>

                                <a class="nav-link"
                                   asp-area="Admin"
                                   asp-controller="Users"
                                   asp-action="Index">

                                    <div class="d-flex align-items-center">
                                        <span class="nav-link-icon">
                                            <i class="fas fa-user-shield"></i>
                                        </span>

                                        <span class="nav-link-text ps-1">
                                            Users
                                        </span>
                                    </div>

                                </a>

                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area="Admin"
                                   asp-controller="Roles"
                                   asp-action="Index">

                                    <div class="d-flex align-items-center">
                                        <span class="nav-link-icon">
                                            <i class="fas fa-user-tag"></i>
                                        </span>

                                        <span class="nav-link-text ps-1">
                                            Roles
                                        </span>
                                    </div>

                                </a>
                            </li>

                        </ul>

                    </div>

                </div>

            </nav>

            <!-- ========================= -->
            <!-- Main Content -->
            <!-- ========================= -->

            <div class="content">

                <!-- Top Navbar -->
                <nav class="navbar navbar-light navbar-glass
                    navbar-top navbar-expand">

                    <!-- Mobile Sidebar Toggle -->
                    <button class="btn navbar-toggler-humburger-icon
                        navbar-toggler me-1 me-sm-3"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#navbarVerticalCollapse"
                            aria-controls="navbarVerticalCollapse"
                            aria-expanded="false"
                            aria-label="Toggle Navigation">

                        <span class="navbar-toggle-icon">
                            <span class="toggle-line"></span>
                        </span>

                    </button>

                    <!-- Page Title -->
                    <div class="d-flex align-items-center">
                        <h5 class="mb-0">
                            @ViewData["Title"]
                        </h5>
                    </div>

                    <!-- Right Navbar -->
                    <ul class="navbar-nav ms-auto flex-row
                        align-items-center">

                        <!-- Home -->
                        <li class="nav-item">
                            <a class="nav-link px-2"
                               asp-area="Admin"
                               asp-controller="Home"
                               asp-action="Index"
                               title="Dashboard">

                                <i class="fas fa-home"></i>

                            </a>
                        </li>

                        <!-- User -->
                        <li class="nav-item dropdown">

                            <a class="nav-link pe-0 ps-2"
                               href="#"
                               id="navbarDropdownUser"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                <div class="avatar avatar-xl">
                                    <div class="avatar-name rounded-circle
                                        bg-soft-primary text-primary">
                                        <span>
                                            <i class="fas fa-user"></i>
                                        </span>
                                    </div>
                                </div>

                            </a>

                            <div class="dropdown-menu dropdown-menu-end
                                py-0"
                                 aria-labelledby="navbarDropdownUser">

                                <div class="bg-white rounded-2 py-2">

                                    <div class="dropdown-item-text">
                                        <strong>Administrator</strong>
                                    </div>

                                    <div class="dropdown-divider"></div>

                                    <a class="dropdown-item"
                                       asp-area="Admin"
                                       asp-controller="Home"
                                       asp-action="Index">
                                        Dashboard
                                    </a>

                                    <div class="dropdown-divider"></div>

                                    <!-- Logout -->
                                    <form asp-area="Identity"
                                          asp-page="/Account/Logout"
                                          asp-route-returnUrl="/Identity/Account/Login"
                                          method="post">

                                        <button type="submit"
                                                class="dropdown-item text-danger">
                                            <i class="fas fa-sign-out-alt me-2"></i>
                                            Logout
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </li>

                    </ul>

                </nav>

                <!-- ========================= -->
                <!-- Page Content -->
                <!-- ========================= -->

                <div class="container-fluid py-3">

                    @RenderBody()

                </div>

                <!-- ========================= -->
                <!-- Footer -->
                <!-- ========================= -->

                <footer class="footer">

                    <div class="row g-0 justify-content-between
                        align-items-center fs--1 mt-4 mb-3">

                        <div class="col-12 col-sm-auto text-center">
                            <p class="mb-0 text-600">
                                Flight Booking System
                                <span class="d-none d-sm-inline-block">
                                    |
                                </span>
                                <span class="d-sm-none">
                                    <br />
                                </span>
                                &copy; 2026
                            </p>
                        </div>

                        <div class="col-12 col-sm-auto text-center">
                            <p class="mb-0 text-600">
                                Admin Panel
                            </p>
                        </div>

                    </div>

                </footer>

            </div>

        </div>

    </main>

    <!-- ========================= -->
    <!-- JavaScript -->
    <!-- ========================= -->

    <script src="~/vendors/popper/popper.min.js"></script>

    <script src="~/vendors/bootstrap/bootstrap.min.js"></script>

    <script src="~/vendors/simplebar/simplebar.min.js"></script>

    <script src="~/vendors/fontawesome/all.min.js"></script>

    <script src="~/assets/js/theme.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
```

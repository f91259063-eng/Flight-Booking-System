@model StaffFlightSearchViewModel
@{
    ViewData["Title"] = "Flights";
    var canBook = User.IsInRole("Admin") || User.IsInRole("BookingAgent");
}

<div class="card mb-3">
    <div class="card-header"><h5 class="mb-0">Flights and available seats</h5></div>
    <div class="card-body bg-light">
        <form method="get" asp-area="Staff" asp-controller="Flights" asp-action="Index" class="row g-2">
            <div class="col-md-3">
                <input name="from" value="@Model.From" class="form-control" placeholder="From airport" />
            </div>
            <div class="col-md-3">
                <input name="to" value="@Model.To" class="form-control" placeholder="To airport" />
            </div>
            <div class="col-md-3">
                <input name="date" type="date" value="@(Model.Date?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">Search</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive scrollbar">
            <table class="table table-hover table-striped fs--1 mb-0 overflow-hidden align-middle">
                <thead class="bg-200 text-900">
                    <tr>
                        <th>Flight</th>
                        <th>Route</th>
                        <th>Departure</th>
                        <th>Arrival</th>
                        <th>Seats</th>
                        @if (canBook)
                        {
                            <th class="text-end"></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model.Flights)
                    {
                        <tr>
                            <td>
                                <div class="fw-semi-bold">@f.FlightNumber</div>
                                <div class="text-600">@f.Airline</div>
                            </td>
                            <td>@f.From to @f.To</td>
                            <td>@f.Departure.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@f.Arrival.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @if (f.AvailableSeats == 0)
                                {
                                    <span class="badge rounded-pill badge-soft-danger">Full</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill badge-soft-success">@f.AvailableSeats free</span>
                                }
                                <span class="text-600 ms-1">of @f.TotalSeats</span>
                            </td>
                            @if (canBook)
                            {
                                <td class="text-end">
                                    <a class="btn btn-falcon-primary btn-sm" asp-area="Customer" asp-controller="Flights" asp-action="Details" asp-route-id="@f.FlightId">Book</a>
                                </td>
                            }
                        </tr>
                    }

                    @if (!Model.Flights.Any())
                    {
                        <tr>
                            <td colspan="@(canBook ? 6 : 5)" class="text-center text-600 p-4">No flights found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

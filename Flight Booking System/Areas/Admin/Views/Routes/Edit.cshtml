@model Flight_Booking_System.Models.Route

@{
    ViewData["Title"] = "تعديل مسار";
}

<div class="container mt-4">
    <h2 class="mb-4">تعديل مسار الطيران رقم @Model.Id</h2>

    <form asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" name="id" value="@Model.Id" />

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label class="form-label">مطار المغادرة</label>
            <select name="FromAirportId"
                    asp-items="ViewBag.FromAirports"
                    class="form-select"
                    required>
                <option value="">-- اختر مطار المغادرة --</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">مطار الوصول</label>
            <select name="ToAirportId"
                    asp-items="ViewBag.ToAirports"
                    class="form-select"
                    required>
                <option value="">-- اختر مطار الوصول --</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">المسافة الحالية (كم)</label>
            <input class="form-control"
                   value="@Model.Distance.ToString("F2")"
                   readonly />
            <small class="text-muted">
                ستتم إعادة حساب المسافة عند حفظ التعديلات.
            </small>
        </div>

        <button type="submit" class="btn btn-primary">
            حفظ التعديلات
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            إلغاء
        </a>
    </form>
</div>
@model Flight_Booking_System.Models.Payment

@{
    ViewData["Title"] = "Payment Details";
    Layout = "_AdminLayout";

    var isPaid = Model.PaymentStatus;

    var statusText = isPaid ? "Paid" : "Unpaid";
    var statusClass = isPaid ? "bg-success" : "bg-warning text-dark";

    var booking = Model.Booking;
}

<div class="container-fluid py-4" dir="ltr">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <a asp-area="Admin"
                   asp-controller="Payments"
                   asp-action="Index"
                   class="text-decoration-none text-muted">
                    Payments
                </a>

                <i class="fas fa-chevron-right text-muted small"></i>

                <span class="text-muted small">Payment Details</span>
            </div>

            <h2 class="fw-bold mb-1">Payment Details</h2>

            <p class="text-muted mb-0">
                Review payment transaction and associated booking information.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Payments"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>
            Back to Payments
        </a>
    </div>

    <!-- Payment Overview -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

            <div class="row align-items-center g-4">

                <div class="col-lg-4">
                    <div class="text-muted small mb-2">Payment Reference</div>

                    <h3 class="fw-bold text-primary mb-2">
                        #@Model.Id
                    </h3>

                    <span class="badge @statusClass px-3 py-2">
                        <i class="fas @(isPaid ? "fa-check-circle" : "fa-clock") me-1"></i>
                        @statusText
                    </span>
                </div>

                <div class="col-lg-4">
                    <div class="text-muted small mb-2">Payment Amount</div>

                    <h3 class="fw-bold mb-0">
                        @Model.Amount.ToString("N2")
                        <small class="fs-6 text-muted">EGP</small>
                    </h3>
                </div>

                <div class="col-lg-4">
                    <div class="text-muted small mb-2">Payment Date</div>

                    <div class="fw-semibold">
                        <i class="far fa-calendar-alt text-primary me-2"></i>
                        @Model.PaymentDate.ToString("dd MMM yyyy")
                    </div>

                    <small class="text-muted">
                        @Model.PaymentDate.ToString("hh:mm tt")
                    </small>
                </div>

            </div>

        </div>
    </div>

    <div class="row g-4">

        <!-- Payment Information -->
        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 px-4 pt-4">
                    <h5 class="fw-bold mb-0">
                        <i class="fas fa-credit-card text-primary me-2"></i>
                        Payment Information
                    </h5>
                </div>

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                        <span class="text-muted">Payment ID</span>
                        <strong>#@Model.Id</strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                        <span class="text-muted">Payment Method</span>
                        <strong>
                            @Model.PaymentMethod
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                        <span class="text-muted">Payment Status</span>
                        <span class="badge @statusClass px-3 py-2">
                            @statusText
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted">Transaction Amount</span>
                        <strong class="text-success">
                            @Model.Amount.ToString("N2") EGP
                        </strong>
                    </div>

                </div>

            </div>

        </div>

        <!-- Booking Information -->
        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 px-4 pt-4">
                    <h5 class="fw-bold mb-0">
                        <i class="fas fa-ticket-alt text-primary me-2"></i>
                        Booking Information
                    </h5>
                </div>

                <div class="card-body p-4">

                    @if (booking != null)
                    {
                        <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                            <span class="text-muted">Booking ID</span>
                            <strong>#@booking.Id</strong>
                        </div>

                        <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                            <span class="text-muted">Booking Reference</span>
                            <strong class="text-primary">
                                @booking.BookingReference
                            </strong>
                        </div>

                        <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                            <span class="text-muted">Booking Status</span>
                            <strong>@booking.Status</strong>
                        </div>

                        <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                            <span class="text-muted">Number of Tickets</span>
                            <strong>@booking.NumberOfTickets</strong>
                        </div>

                        <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                            <span class="text-muted">Redeemed Points</span>
                            <strong>@booking.PointsRedeemed</strong>
                        </div>

                        <div class="d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted">Booking Discount</span>
                            <strong class="text-danger">
                                @booking.DiscountAmount.ToString("N2") EGP
                            </strong>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-exclamation-circle fa-2x text-warning mb-3"></i>

                            <h6 class="fw-bold">Booking Not Available</h6>

                            <p class="text-muted mb-0">
                                The associated booking information could not be loaded.
                            </p>
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

    <!-- Transaction Summary -->
    <div class="card border-0 shadow-sm mt-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">
                <i class="fas fa-info-circle text-primary me-2"></i>
                Transaction Summary
            </h5>

            <div class="row g-3">

                <div class="col-md-4">
                    <div class="rounded-3 bg-light p-3 h-100">
                        <div class="text-muted small mb-2">Payment Record</div>
                        <div class="fw-semibold">#@Model.Id</div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="rounded-3 bg-light p-3 h-100">
                        <div class="text-muted small mb-2">Payment Method</div>
                        <div class="fw-semibold">@Model.PaymentMethod</div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="rounded-3 bg-light p-3 h-100">
                        <div class="text-muted small mb-2">Final Payment Amount</div>
                        <div class="fw-bold text-success">
                            @Model.Amount.ToString("N2") EGP
                        </div>
                    </div>
                </div>

            </div>

            <div class="alert alert-info mt-4 mb-0">
                <i class="fas fa-info-circle me-2"></i>

                This page displays the payment information saved in the system.
                It does not perform refunds or modify payment status.
            </div>

        </div>

    </div>

    <!-- Footer -->
    <div class="d-flex justify-content-end mt-4">
        <a asp-area="Admin"
           asp-controller="Payments"
           asp-action="Index"
           class="btn btn-outline-secondary px-4">
            <i class="fas fa-arrow-left me-2"></i>
            Back to Payments
        </a>
    </div>

</div>

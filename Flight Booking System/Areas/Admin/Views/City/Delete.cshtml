@model Flight_Booking_System.Models.city

@{
    ViewData["Title"] = "Delete City";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="ltr">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="text-danger fw-semibold small text-uppercase">
                Location Management
            </span>
            <h2 class="fw-bold mb-1">Delete City</h2>
            <p class="text-muted mb-0">
                Review the city information before confirming deletion.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="City"
           asp-action="Index"
           class="btn btn-light border">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Cities
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-7 col-xl-6">

            <div class="card flight-form-card border-0 shadow-sm">

                <!-- Card Header -->
                <div class="card-header bg-white p-4">
                    <div class="d-flex align-items-center gap-3">

                        <div class="flight-form-header-icon"
                             style="background:#fff0f0;color:#dc3545;">
                            <i class="bi bi-trash3"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">Confirm Deletion</h5>
                            <p class="text-muted small mb-0">
                                City information and deletion confirmation
                            </p>
                        </div>

                    </div>
                </div>

                <!-- Card Body -->
                <div class="card-body p-4">

                    <div class="alert alert-warning d-flex align-items-start gap-3"
                         role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>

                        <div>
                            <strong>Warning!</strong>
                            <p class="mb-0 mt-1">
                                Are you sure you want to delete this city?
                                This action cannot be easily undone.
                            </p>
                        </div>
                    </div>

                    <h6 class="flight-section-title mb-3">
                        <i class="bi bi-info-circle"></i>
                        City Information
                    </h6>

                    <div class="border rounded-3 p-3">

                        <dl class="row mb-0">

                            <dt class="col-sm-4 text-muted py-2">
                                City ID
                            </dt>
                            <dd class="col-sm-8 fw-semibold py-2 mb-0">
                                @Model.Id
                            </dd>

                            <dt class="col-sm-4 text-muted py-2">
                                City Name
                            </dt>
                            <dd class="col-sm-8 fw-semibold py-2 mb-0">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="airline-table-icon">
                                        <i class="bi bi-geo-alt"></i>
                                    </div>
                                    @Model.Name
                                </div>
                            </dd>

                        </dl>

                    </div>

                    <hr class="my-4" />

                    <!-- Delete Form -->
                    <form asp-area="Admin"
                          asp-controller="City"
                          asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="d-flex flex-wrap justify-content-end gap-2">

                            <a asp-area="Admin"
                               asp-controller="City"
                               asp-action="Index"
                               class="btn btn-light border px-4">
                                <i class="bi bi-x-circle me-1"></i>
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-danger px-4">
                                <i class="bi bi-trash3 me-1"></i>
                                Confirm Delete
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

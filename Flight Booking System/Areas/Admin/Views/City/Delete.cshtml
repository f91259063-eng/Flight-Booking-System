@model Flight_Booking_System.Models.city

@{
    ViewData["Title"] = "Delete City";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="ltr">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Delete City</h2>
        <p class="text-muted mb-0">
            Review the city information before confirming deletion.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-danger">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Confirm Deletion
                    </h5>
                </div>

                <div class="card-body p-4">

                    <div class="alert alert-warning" role="alert">
                        Are you sure you want to delete this city?
                        This action cannot be easily undone.
                    </div>

                    <dl class="row mb-4">
                        <dt class="col-sm-4">City ID</dt>
                        <dd class="col-sm-8">@Model.Id</dd>

                        <dt class="col-sm-4">City Name</dt>
                        <dd class="col-sm-8">@Model.Name</dd>
                    </dl>

                    <hr />

                    <form asp-area="Admin"
                          asp-controller="City"
                          asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-1"></i>
                                Confirm Delete
                            </button>

                            <a asp-area="Admin"
                               asp-controller="City"
                               asp-action="Index"
                               class="btn btn-light border">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

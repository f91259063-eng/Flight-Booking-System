@model IEnumerable<Flight_Booking_System.ViewModels.UserRowViewModel>

@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";

    var users = Model?.ToList()
        ?? new List<Flight_Booking_System.ViewModels.UserRowViewModel>();

    var totalUsers = users.Count;
    var activeUsers = users.Count(u => !u.IsLocked);
    var adminUsers = users.Count(u => u.IsAdmin);
    var lockedUsers = users.Count(u => u.IsLocked);
}

<div class="container-fluid py-4" dir="ltr">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="text-primary fw-semibold small">SYSTEM ADMINISTRATION</span>
                <i class="fas fa-chevron-right text-muted small"></i>
                <span class="text-muted small">Users</span>
            </div>

            <h2 class="fw-bold mb-1">User Management</h2>
            <p class="text-secondary mb-0">
                Manage system users, roles, account security and activity history.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Admin"
           asp-action="CreateUser"
           class="btn btn-primary rounded-3 px-4 py-2">
            <i class="fas fa-user-plus me-2"></i>
            Add New User
        </a>
    </div>

    <!-- Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm"
             role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 border-0 shadow-sm"
             role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-secondary mb-2">Total Users</p>
                            <h3 class="fw-bold mb-0">@totalUsers</h3>
                            <small class="text-secondary">Registered accounts</small>
                        </div>
                        <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-secondary mb-2">Active Users</p>
                            <h3 class="fw-bold mb-0">@activeUsers</h3>
                            <small class="text-secondary">Available accounts</small>
                        </div>
                        <div class="stat-icon bg-success bg-opacity-10 text-success">
                            <i class="fas fa-user-check"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-secondary mb-2">Administrators</p>
                            <h3 class="fw-bold mb-0">@adminUsers</h3>
                            <small class="text-secondary">Admin accounts</small>
                        </div>
                        <div class="stat-icon bg-danger bg-opacity-10 text-danger">
                            <i class="fas fa-user-shield"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-secondary mb-2">Suspended Users</p>
                            <h3 class="fw-bold mb-0">@lockedUsers</h3>
                            <small class="text-secondary">Locked accounts</small>
                        </div>
                        <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                            <i class="fas fa-user-lock"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Users Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header bg-transparent border-0 p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>
                    <h5 class="fw-bold mb-1">
                        <i class="fas fa-users text-primary me-2"></i>
                        System Users
                    </h5>
                    <p class="text-secondary small mb-0">
                        View and manage registered system accounts.
                    </p>
                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <div class="input-group">
                        <span class="input-group-text bg-body-tertiary border-end-0">
                            <i class="fas fa-search text-secondary"></i>
                        </span>
                        <input type="search"
                               id="userSearch"
                               class="form-control border-start-0"
                               placeholder="Search users..." />
                    </div>

                    <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary px-3 py-2">
                        @totalUsers Users
                    </span>
                </div>

            </div>
        </div>

        <div class="table-responsive">

            <table class="table align-middle table-hover mb-0" id="usersTable">

                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3">User</th>
                        <th>Email Address</th>
                        <th>Role</th>
                        <th>Account Status</th>
                        <th>Security</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody id="usersTableBody">

                    @if (users.Any())
                    {
                        @foreach (var u in users)
                        {
                            <tr class="user-row">

                                <!-- User -->
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="user-avatar">
                                            <i class="fas fa-user"></i>
                                        </div>

                                        <div>
                                            <div class="fw-semibold user-name">
                                                @u.FullName
                                            </div>
                                            <small class="text-secondary">
                                                User Account
                                            </small>
                                        </div>
                                    </div>
                                </td>

                                <!-- Email -->
                                <td>
                                    <div class="user-email">@u.Email</div>

                                    @if (!u.EmailConfirmed)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning-emphasis mt-1">
                                            <i class="fas fa-exclamation-circle me-1"></i>
                                            Unverified
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success mt-1">
                                            <i class="fas fa-check-circle me-1"></i>
                                            Verified
                                        </span>
                                    }
                                </td>

                                <!-- Role -->
                                <td>
                                    <span class="badge rounded-pill px-3 py-2 @(u.IsAdmin ? "bg-danger bg-opacity-10 text-danger" : "bg-primary bg-opacity-10 text-primary")">
                                        <i class="fas @(u.IsAdmin ? "fa-user-shield" : "fa-user") me-1"></i>
                                        @(u.IsAdmin ? "Administrator" : "Customer")
                                    </span>
                                </td>

                                <!-- Status -->
                                <td>
                                    @if (u.IsLocked)
                                    {
                                        <span class="status-indicator text-danger">
                                            <span class="status-dot bg-danger"></span>
                                            Suspended
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-indicator text-success">
                                            <span class="status-dot bg-success"></span>
                                            Active
                                        </span>
                                    }
                                </td>

                                <!-- Security -->
                                <td>
                                    @if (u.TwoFactorEnabled)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">
                                            <i class="fas fa-shield-alt me-1"></i>
                                            2FA Enabled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2">
                                            2FA Disabled
                                        </span>
                                    }
                                </td>

                                <!-- Actions -->
                                <td class="text-center">
                                    <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap">

                                        <a asp-area="Admin"
                                           asp-controller="Admin"
                                           asp-action="EditUser"
                                           asp-route-id="@u.Id"
                                           class="btn btn-sm btn-outline-primary action-btn"
                                           title="Edit User">
                                            <i class="fas fa-edit"></i>
                                            <span>Edit</span>
                                        </a>

                                        <a asp-area="Admin"
                                           asp-controller="ActivityLog"
                                           asp-action="Index"
                                           asp-route-userId="@u.Id"
                                           class="btn btn-sm btn-outline-secondary action-btn"
                                           title="Activity History">
                                            <i class="fas fa-history"></i>
                                            <span>History</span>
                                        </a>

                                        <form asp-area="Admin"
                                              asp-controller="Admin"
                                              asp-action="ToggleAdmin"
                                              asp-route-id="@u.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to change this user role?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-warning action-btn">
                                                <i class="fas fa-user-shield"></i>
                                                <span>@(u.IsAdmin ? "Demote" : "Promote")</span>
                                            </button>
                                        </form>

                                        <form asp-area="Admin"
                                              asp-controller="Admin"
                                              asp-action="ToggleLock"
                                              asp-route-id="@u.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to change this account status?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm @(u.IsLocked ? "btn-outline-success" : "btn-outline-danger") action-btn">
                                                <i class="fas @(u.IsLocked ? "fa-unlock" : "fa-lock")"></i>
                                                <span>@(u.IsLocked ? "Activate" : "Suspend")</span>
                                            </button>
                                        </form>

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="empty-state">
                                    <div class="empty-state-icon">
                                        <i class="fas fa-users"></i>
                                    </div>
                                    <h5 class="fw-bold mt-3">No Users Found</h5>
                                    <p class="text-secondary mb-3">
                                        There are no user records available in the system.
                                    </p>
                                    <a asp-area="Admin"
                                       asp-controller="Admin"
                                       asp-action="CreateUser"
                                       class="btn btn-primary rounded-3">
                                        <i class="fas fa-user-plus me-2"></i>
                                        Add First User
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }

                    <tr id="noSearchResults" class="d-none">
                        <td colspan="6" class="text-center py-4 text-secondary">
                            <i class="fas fa-search me-2"></i>
                            No users match your search.
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>

        <div class="card-footer bg-transparent border-0 px-4 py-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <small class="text-secondary">
                    Total registered users: <strong>@totalUsers</strong>
                </small>
                <small class="text-secondary">
                    User Management
                    <i class="fas fa-lock ms-1 text-success"></i>
                </small>
            </div>
        </div>

    </div>
</div>

<style>
    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        flex-shrink: 0;
    }

    .user-avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bs-primary-bg-subtle);
        color: var(--bs-primary);
        flex-shrink: 0;
    }

    .status-indicator {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-weight: 600;
        font-size: .875rem;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .action-btn {
        border-radius: 8px;
        white-space: nowrap;
    }

    .empty-state {
        max-width: 360px;
        margin: auto;
    }

    .empty-state-icon {
        width: 76px;
        height: 76px;
        margin: auto;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bs-secondary-bg);
        color: var(--bs-secondary-color);
        font-size: 30px;
    }

    @@media (max-width: 767.98px) {
        .action-btn span {
            display: none;
        }

        .action-btn {
            width: 34px;
            height: 34px;
            padding: 0;
        }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchElement = document.getElementById("userSearch");
            const tableBody = document.getElementById("usersTableBody");
            const noResultsElement = document.getElementById("noSearchResults");

            if (!(searchElement instanceof HTMLInputElement)) return;
            if (!(tableBody instanceof HTMLTableSectionElement)) return;
            if (!(noResultsElement instanceof HTMLTableRowElement)) return;

            const searchInput = searchElement;
            const tbody = tableBody;
            const noResults = noResultsElement;

            searchInput.addEventListener("input", function () {
                const searchText = searchInput.value.trim().toLowerCase();
                const rows = tbody.querySelectorAll("tr.user-row");

                let visibleCount = 0;

                rows.forEach(function (row) {
                    const rowText = row.textContent?.toLowerCase() ?? "";
                    const matches = rowText.includes(searchText);

                    row.classList.toggle("d-none", !matches);

                    if (matches) {
                        visibleCount++;
                    }
                });

                noResults.classList.toggle(
                    "d-none",
                    visibleCount > 0 || searchText.length === 0
                );
            });
        });
    </script>
}

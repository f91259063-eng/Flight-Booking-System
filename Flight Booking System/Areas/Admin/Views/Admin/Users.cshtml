@model IEnumerable<Flight_Booking_System.ViewModels.UserRowViewModel>

@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";
}

<div class="card">

    <div class="card-header bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">

        <h5 class="mb-0">
            <i class="fas fa-users me-2"></i>
            User Management (@Model.Count())
        </h5>

        <a asp-controller="Admin"
           asp-action="CreateUser"
           class="btn btn-falcon-primary btn-sm">

            <i class="fas fa-user-plus me-1"></i>
            Add New User

        </a>

    </div>

    <div class="card-body p-0">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success m-3">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger m-3">
                @TempData["Error"]
            </div>
        }

        <div class="table-responsive scrollbar">

            <table class="table table-hover table-striped fs--1 mb-0 overflow-hidden align-middle">

                <thead class="bg-200 text-900">
                    <tr>
                        <th>Full Name</th>
                        <th>Email Address</th>
                        <th>User Role</th>
                        <th>Account Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        foreach (var u in Model)
                        {
                            <tr>

                                <td class="fw-semi-bold">
                                    @u.FullName
                                </td>

                                <td>
                                    @u.Email

                                    @if (!u.EmailConfirmed)
                                    {
                                        <span class="badge rounded-pill badge-soft-warning ms-1">
                                            Unverified
                                        </span>
                                    }

                                    @if (u.TwoFactorEnabled)
                                    {
                                        <span class="badge rounded-pill badge-soft-success ms-1">
                                            2FA Enabled
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="badge rounded-pill @(u.IsAdmin ? "badge-soft-danger" : "badge-soft-primary")">
                                        @(u.IsAdmin ? "Administrator" : "Customer")
                                    </span>
                                </td>

                                <td>
                                    <span class="badge rounded-pill @(u.IsLocked ? "badge-soft-danger" : "badge-soft-success")">
                                        @(u.IsLocked ? "Suspended" : "Active")
                                    </span>
                                </td>

                                <td class="text-end text-nowrap">

                                    <!-- Edit User -->

                                    <a asp-controller="Admin"
                                       asp-action="EditUser"
                                       asp-route-id="@u.Id"
                                       class="btn btn-falcon-default btn-sm"
                                       title="Edit User">

                                        <i class="fas fa-edit me-1"></i>
                                        Edit

                                    </a>

                                    <!-- Audit History -->

                                    <a asp-area="Admin"
                                       asp-controller="ActivityLog"
                                       asp-action="Index"
                                       asp-route-userId="@u.Id"
                                       class="btn btn-falcon-default btn-sm"
                                       title="View Audit History">

                                        <i class="fas fa-history me-1"></i>
                                        History

                                    </a>

                                    <!-- Change User Role -->

                                    <form asp-controller="Admin"
                                          asp-action="ToggleAdmin"
                                          asp-route-id="@u.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to change this user role?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-falcon-default btn-sm">

                                            @(u.IsAdmin ? "Demote to Customer" : "Promote to Admin")

                                        </button>

                                    </form>

                                    <!-- Lock / Unlock Account -->

                                    <form asp-controller="Admin"
                                          asp-action="ToggleLock"
                                          asp-route-id="@u.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to change this account status?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-falcon-@(u.IsLocked ? "success" : "danger") btn-sm">

                                            <i class="fas @(u.IsLocked ? "fa-unlock" : "fa-lock") me-1"></i>

                                            @(u.IsLocked ? "Activate" : "Suspend")

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">

                                <i class="fas fa-users fa-2x mb-2"></i>

                                <p class="mb-0">
                                    No user records found.
                                </p>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

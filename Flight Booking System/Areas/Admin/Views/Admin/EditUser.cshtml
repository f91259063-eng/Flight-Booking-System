@model Flight_Booking_System.ViewModels.UserEditViewModel

@{
    ViewData["Title"] = "Edit User";
    Layout = "_AdminLayout";

    var roles = ViewBag.Roles as IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>
                ?? Enumerable.Empty<Microsoft.AspNetCore.Identity.IdentityRole>();

    var selectedRoles = Model.SelectedRoles ?? new List<string>();
}

<div class="container-fluid py-4" dir="ltr">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="text-primary fw-semibold small">USER MANAGEMENT</span>
                <i class="fas fa-chevron-right text-muted small"></i>
                <span class="text-muted small">Edit User</span>
            </div>

            <h2 class="fw-bold mb-1">Edit User Account</h2>
            <p class="text-secondary mb-0">
                Manage personal information, security and assigned roles.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Admin"
           asp-action="Users"
           class="btn btn-outline-secondary rounded-3 px-3">
            <i class="fas fa-arrow-left me-2"></i>
            Back to Users
        </a>
    </div>

    <form asp-area="Admin"
          asp-controller="Admin"
          asp-action="EditUser"
          method="post">

        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger rounded-3 mb-4"
             role="alert"></div>

        <div class="row g-4">

            <!-- Main Information -->
            <div class="col-12 col-xl-8">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-header bg-transparent border-0 px-4 pt-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3">
                                <i class="fas fa-user fa-lg"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">Personal Information</h5>
                                <p class="text-secondary small mb-0">
                                    Update the user's basic account details.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-4">

                        <div class="row g-4">

                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-semibold">
                                    First Name
                                </label>
                                <input asp-for="FirstName"
                                       class="form-control form-control-lg rounded-3"
                                       placeholder="Enter first name" />
                                <span asp-validation-for="FirstName"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-semibold">
                                    Last Name
                                </label>
                                <input asp-for="LastName"
                                       class="form-control form-control-lg rounded-3"
                                       placeholder="Enter last name" />
                                <span asp-validation-for="LastName"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold">
                                    Email Address
                                </label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-body-tertiary">
                                        <i class="fas fa-envelope text-secondary"></i>
                                    </span>
                                    <input asp-for="Email"
                                           type="email"
                                           class="form-control rounded-end-3"
                                           placeholder="name@example.com" />
                                </div>
                                <span asp-validation-for="Email"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-semibold">
                                    Phone Number
                                </label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-body-tertiary">
                                        <i class="fas fa-phone text-secondary"></i>
                                    </span>
                                    <input asp-for="PhoneNumber"
                                           type="tel"
                                           class="form-control rounded-end-3"
                                           placeholder="Enter phone number" />
                                </div>
                                <span asp-validation-for="PhoneNumber"
                                      class="text-danger small"></span>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- Account Security -->
            <div class="col-12 col-xl-4">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-header bg-transparent border-0 px-4 pt-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 bg-success bg-opacity-10 text-success p-3">
                                <i class="fas fa-shield-alt fa-lg"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">Account Security</h5>
                                <p class="text-secondary small mb-0">
                                    Current security status.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                            <div>
                                <div class="fw-semibold">Email Verification</div>
                                <small class="text-secondary">Email confirmation</small>
                            </div>

                            @if (Model.EmailConfirmed)
                            {
                                <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2">
                                    <i class="fas fa-check-circle me-1"></i> Verified
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-warning bg-opacity-10 text-warning-emphasis px-3 py-2">
                                    <i class="fas fa-exclamation-circle me-1"></i> Unverified
                                </span>
                            }
                        </div>

                        <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                            <div>
                                <div class="fw-semibold">Two-Factor Auth</div>
                                <small class="text-secondary">Additional protection</small>
                            </div>

                            @if (Model.TwoFactorEnabled)
                            {
                                <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2">
                                    Enabled
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary px-3 py-2">
                                    Disabled
                                </span>
                            }
                        </div>

                        <div class="d-flex justify-content-between align-items-center py-3">
                            <div>
                                <div class="fw-semibold">Account Status</div>
                                <small class="text-secondary">Access availability</small>
                            </div>

                            @if (Model.IsLocked)
                            {
                                <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger px-3 py-2">
                                    <i class="fas fa-lock me-1"></i> Suspended
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2">
                                    <i class="fas fa-unlock me-1"></i> Active
                                </span>
                            }
                        </div>

                        <div class="alert alert-light border rounded-3 small mb-0 mt-2">
                            <i class="fas fa-info-circle text-primary me-1"></i>
                            Account security settings are displayed here.
                            Use User Management to change account status.
                        </div>

                    </div>
                </div>
            </div>

            <!-- Roles -->
            <div class="col-12">

                <div class="card border-0 shadow-sm rounded-4">

                    <div class="card-header bg-transparent border-0 px-4 pt-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-3 bg-info bg-opacity-10 text-info p-3">
                                    <i class="fas fa-user-tag fa-lg"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-1">Assigned Roles</h5>
                                    <p class="text-secondary small mb-0">
                                        Select the roles assigned to this user.
                                    </p>
                                </div>
                            </div>

                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">
                                <span id="selectedRoleCount">0</span> Selected
                            </span>
                        </div>
                    </div>

                    <div class="card-body p-4">

                        @if (roles.Any())
                        {
                            <div class="row g-3">

                                @foreach (var role in roles)
                                {
                                    var roleName = role.Name ?? "";
                                    var selected = selectedRoles.Contains(roleName);

                                    <div class="col-12 col-sm-6 col-lg-4">

                                        <label for="role_@role.Id"
                                               class="role-option d-flex align-items-center gap-3 border rounded-3 p-3 h-100 @(selected ? "selected" : "")">

                                            <input type="checkbox"
                                                   id="role_@role.Id"
                                                   name="SelectedRoles"
                                                   value="@roleName"
                                                   class="form-check-input role-checkbox mt-0"
                                                   checked="@selected" />

                                            <div class="flex-grow-1">
                                                <div class="fw-semibold">@roleName</div>
                                                <small class="text-secondary">System role</small>
                                            </div>

                                            <i class="fas fa-check-circle text-primary role-check-icon"></i>
                                        </label>

                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning rounded-3 mb-0">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                No roles have been created yet.
                            </div>
                        }

                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="col-12">
                <div class="d-flex justify-content-end gap-2 flex-wrap">
                    <a asp-area="Admin"
                       asp-controller="Admin"
                       asp-action="Users"
                       class="btn btn-light border rounded-3 px-4 py-2">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary rounded-3 px-4 py-2">
                        <i class="fas fa-save me-2"></i>
                        Save Changes
                    </button>
                </div>
            </div>

        </div>
    </form>
</div>

<style>
    .role-option {
        cursor: pointer;
        transition: all .2s ease;
        background: var(--bs-body-bg);
    }

        .role-option:hover {
            border-color: var(--bs-primary) !important;
            background: var(--bs-primary-bg-subtle);
        }

        .role-option.selected {
            border-color: var(--bs-primary) !important;
            background: var(--bs-primary-bg-subtle);
        }

    .role-check-icon {
        opacity: 0;
        transition: opacity .2s ease;
    }

    .role-option.selected .role-check-icon {
        opacity: 1;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const checkboxes = document.querySelectorAll(".role-checkbox");
            const countElement = document.getElementById("selectedRoleCount");

            function updateRoleSelection() {
                let count = 0;

                checkboxes.forEach(function (checkbox) {
                    if (!(checkbox instanceof HTMLInputElement)) return;

                    const label = checkbox.closest(".role-option");

                    if (checkbox.checked) {
                        count++;
                        label?.classList.add("selected");
                    } else {
                        label?.classList.remove("selected");
                    }
                });

                if (countElement) {
                    countElement.textContent = count.toString();
                }
            }

            checkboxes.forEach(function (checkbox) {
                checkbox.addEventListener("change", updateRoleSelection);
            });

            updateRoleSelection();
        });
    </script>
}

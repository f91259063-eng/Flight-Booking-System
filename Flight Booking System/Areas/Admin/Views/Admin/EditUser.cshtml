@model UserEditViewModel
﻿@model Flight_Booking_System.ViewModels.UserEditViewModel

@{
    ViewData["Title"] = "Edit user";
}

@if (TempData["Success"] is string okMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @okMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="fas fa-user-edit text-primary me-2"></i>
                Edit User
            </h2>

            <p class="text-body-secondary mb-0">
                Update user information, assigned roles and account settings.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Users"
           class="btn btn-outline-secondary">

            <i class="fas fa-arrow-left me-1"></i>
            Back to User Management

        </a>

    </div>
}
@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card mb-3">
    <div class="card-header">
        <h5 class="mb-0"><span class="fas fa-user-edit me-2"></span>Edit user</h5>
    </div>
    <div class="card-body">
        <div class="mb-3">
            @if (Model.IsLocked)
            {
                <span class="badge rounded-pill badge-soft-danger me-1">Locked</span>
            }
            @if (Model.TwoFactorEnabled)
            {
                <span class="badge rounded-pill badge-soft-success me-1">2FA on</span>
            }
            @if (Model.IsCurrentUser)
            {
                <span class="badge rounded-pill badge-soft-info me-1">This is you</span>
            }
        </div>

        <form asp-area="Admin" asp-controller="Admin" asp-action="EditUser" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="row gx-2">
                <div class="mb-3 col-md-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger fs--1"></span>
                </div>
                <div class="mb-3 col-md-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger fs--1"></span>
    <!-- Validation Summary -->
    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>

    <form asp-controller="Admin"
          asp-action="EditUser"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="Id" type="hidden" />

        <div class="row g-4">

            <!-- User Information -->
            <div class="col-12 col-xl-8">

                <div class="card h-100">

                    <div class="card-header bg-body-tertiary">
                        <h5 class="mb-0 fw-bold">
                            <i class="fas fa-user me-2 text-primary"></i>
                            User Information
                        </h5>
                    </div>

                    <div class="card-body">

                        <div class="row g-3">

                            <!-- First Name -->
                            <div class="col-md-6">

                                <label asp-for="FirstName" class="form-label">
                                    First Name
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control"
                                       placeholder="Enter first name" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger small"></span>

                            </div>

                            <!-- Last Name -->
                            <div class="col-md-6">

                                <label asp-for="LastName" class="form-label">
                                    Last Name
                                </label>

                                <input asp-for="LastName"
                                       class="form-control"
                                       placeholder="Enter last name" />

                                <span asp-validation-for="LastName"
                                      class="text-danger small"></span>

                            </div>

                            <!-- Email -->
                            <div class="col-md-6">

                                <label asp-for="Email" class="form-label">
                                    Email Address
                                </label>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       placeholder="name@example.com" />

                                <span asp-validation-for="Email"
                                      class="text-danger small"></span>

                            </div>

                            <!-- Phone -->
                            <div class="col-md-6">

                                <label asp-for="PhoneNumber" class="form-label">
                                    Phone Number
                                </label>

                                <input asp-for="PhoneNumber"
                                       type="tel"
                                       class="form-control"
                                       placeholder="Enter phone number" />

                                <span asp-validation-for="PhoneNumber"
                                      class="text-danger small"></span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="row gx-2">
                <div class="mb-3 col-md-4">
                    <label asp-for="UserName" class="form-label"></label>
                    <input asp-for="UserName" class="form-control" autocomplete="off" />
                    <span asp-validation-for="UserName" class="text-danger fs--1"></span>
                </div>
                <div class="mb-3 col-md-4">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger fs--1"></span>
                </div>
                <div class="mb-3 col-md-4">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger fs--1"></span>
            <!-- Account Status -->
            <div class="col-12 col-xl-4">

                <div class="card h-100">

                    <div class="card-header bg-body-tertiary">

                        <h5 class="mb-0 fw-bold">
                            <i class="fas fa-shield-alt me-2 text-primary"></i>
                            Account Status
                        </h5>

                    </div>

                    <div class="card-body">

                        <!-- Email Verification -->
                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <span>Email Verification</span>

                            @if (Model.EmailConfirmed)
                            {
                                <span class="badge bg-success">
                                    Verified
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Unverified
                                </span>
                            }

                        </div>

                        <!-- Two-Factor Authentication -->
                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <span>Two-Factor Authentication</span>

                            @if (Model.TwoFactorEnabled)
                            {
                                <span class="badge bg-success">
                                    Enabled
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Disabled
                                </span>
                            }

                        </div>

                        <!-- Account Status -->
                        <div class="d-flex justify-content-between align-items-center">

                            <span>Account Status</span>

                            @if (Model.IsLocked)
                            {
                                <span class="badge bg-danger">
                                    Suspended
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }

                        </div>

                        <hr />

                        <small class="text-body-secondary">
                            To suspend or activate this account,
                            return to User Management and use the
                            corresponding account action.
                        </small>

                    </div>

                </div>

            </div>

            <div class="form-check mb-3">
                <input asp-for="EmailConfirmed" class="form-check-input" />
                <label asp-for="EmailConfirmed" class="form-check-label"></label>
            </div>

            <div class="mb-3 col-md-6 px-0">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger fs--1"></span>
                <div class="form-text fs--1">Leave it empty to keep the current password.</div>
            </div>

            <div class="mb-3">
                <label class="form-label d-block">Roles</label>
                @foreach (var role in Model.AllRoles)
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role"
                               id="role_@role" checked="@Model.SelectedRoles.Contains(role)" />
                        <label class="form-check-label" for="role_@role">@role</label>
                    </div>
                }
            </div>

            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-area="Admin" asp-controller="Admin" asp-action="Users" class="btn btn-secondary">Back to users</a>
        </form>
    </div>
</div>

<div class="card border border-danger">
    <div class="card-header bg-light">
        <h6 class="mb-0 text-danger"><span class="fas fa-exclamation-triangle me-2"></span>Delete user</h6>
    </div>
    <div class="card-body">
        @if (Model.IsCurrentUser)
        {
            <p class="mb-0 text-600">You can't delete your own account.</p>
        }
        else if (Model.BookingsCount > 0)
        {
            <p class="mb-0 text-600">
                This user has @Model.BookingsCount booking(s), so he can't be deleted. Lock the account from the users list instead.
            </p>
        }
        else
        {
            <p class="fs--1">The account will be deleted for good. This can't be undone.</p>
            <form asp-area="Admin" asp-controller="Admin" asp-action="DeleteUser" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('Delete this user for good?');">
                <button type="submit" class="btn btn-falcon-danger btn-sm"><span class="fas fa-trash me-1"></span>Delete user</button>
            </form>
        }
    </div>
            <!-- User Roles -->
            <div class="col-12">

                <div class="card">

                    <div class="card-header bg-body-tertiary">

                        <h5 class="mb-0 fw-bold">
                            <i class="fas fa-user-tag me-2 text-primary"></i>
                            User Roles
                        </h5>

                    </div>

                    <div class="card-body">

                        @if (roles.Any())
                        {
                            <p class="text-body-secondary mb-3">
                                Select all roles assigned to this user.
                            </p>

                            <div class="row g-3">

                                @foreach (var role in roles)
                                {
                                    var selected = Model.SelectedRoles != null
                                        && Model.SelectedRoles.Contains(role.Name ?? "");

                                    <div class="col-12 col-sm-6 col-lg-4">

                                        <label class="border rounded p-3 d-flex align-items-center gap-2 h-100"
                                               for="role_@role.Id"
                                               style="cursor:pointer;">

                                            <input type="checkbox"
                                                   id="role_@role.Id"
                                                   name="SelectedRoles"
                                                   value="@role.Name"
                                                   class="form-check-input mt-0"
                                                   checked="@selected" />

                                            <span class="fw-semibold">
                                                @role.Name
                                            </span>

                                        </label>

                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0">
                                No roles have been created yet.
                            </div>
                        }

                    </div>

                </div>

            </div>

            <!-- Form Actions -->
            <div class="col-12">

                <div class="d-flex justify-content-end gap-2 flex-wrap">

                    <a asp-controller="Admin"
                       asp-action="Users"
                       class="btn btn-light border">

                        <i class="fas fa-times me-1"></i>
                        Cancel

                    </a>

                    <button type="submit" class="btn btn-primary">

                        <i class="fas fa-save me-1"></i>
                        Save Changes

                    </button>

                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

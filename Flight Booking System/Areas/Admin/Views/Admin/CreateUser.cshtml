@model Flight_Booking_System.ViewModels.UserCreateViewModel

@{
    ViewData["Title"] = "Create User";
    Layout = "_AdminLayout";

    var roles = ViewBag.Roles as IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>
                ?? Enumerable.Empty<Microsoft.AspNetCore.Identity.IdentityRole>();
}

<div class="container-fluid py-4" dir="ltr">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="text-primary fw-semibold small">USER MANAGEMENT</span>
                <i class="fas fa-chevron-right text-muted small"></i>
                <span class="text-muted small">Create User</span>
            </div>

            <h2 class="fw-bold mb-1">Create New User</h2>
            <p class="text-secondary mb-0">
                Add a new user account and configure their system roles.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Admin"
           asp-action="Users"
           class="btn btn-outline-secondary rounded-3 px-3">
            <i class="fas fa-arrow-left me-2"></i>
            Back to Users
        </a>
    </div>

    <!-- Validation Summary -->
    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger rounded-3 mb-4"
         role="alert"></div>

    <form asp-area="Admin"
          asp-controller="Admin"
          asp-action="CreateUser"
          method="post">

        @Html.AntiForgeryToken()

        <div class="row g-4">

            <!-- User Information -->
            <div class="col-12 col-xl-8">

                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-transparent border-0 px-4 pt-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="section-icon bg-primary bg-opacity-10 text-primary">
                                <i class="fas fa-user fa-lg"></i>
                            </div>

                            <div>
                                <h5 class="fw-bold mb-1">Personal Information</h5>
                                <p class="text-secondary small mb-0">
                                    Enter the user's basic account information.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        <div class="row g-4">

                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-semibold">
                                    First Name
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control form-control-lg rounded-3"
                                       placeholder="Enter first name" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-semibold">
                                    Last Name
                                </label>

                                <input asp-for="LastName"
                                       class="form-control form-control-lg rounded-3"
                                       placeholder="Enter last name" />

                                <span asp-validation-for="LastName"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold">
                                    Email Address
                                </label>

                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-body-tertiary">
                                        <i class="fas fa-envelope text-secondary"></i>
                                    </span>

                                    <input asp-for="Email"
                                           type="email"
                                           class="form-control rounded-end-3"
                                           placeholder="name@example.com" />
                                </div>

                                <span asp-validation-for="Email"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-semibold">
                                    Phone Number
                                </label>

                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-body-tertiary">
                                        <i class="fas fa-phone text-secondary"></i>
                                    </span>

                                    <input asp-for="PhoneNumber"
                                           type="tel"
                                           class="form-control rounded-end-3"
                                           placeholder="Enter phone number" />
                                </div>

                                <span asp-validation-for="PhoneNumber"
                                      class="text-danger small"></span>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Password Information -->
                <div class="card border-0 shadow-sm rounded-4 mt-4">

                    <div class="card-header bg-transparent border-0 px-4 pt-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="section-icon bg-warning bg-opacity-10 text-warning">
                                <i class="fas fa-lock fa-lg"></i>
                            </div>

                            <div>
                                <h5 class="fw-bold mb-1">Password & Security</h5>
                                <p class="text-secondary small mb-0">
                                    Set secure login credentials for this account.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        <div class="row g-4">

                            <!-- Password -->
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-semibold">
                                    Password
                                </label>

                                <div class="input-group input-group-lg">
                                    <input asp-for="Password"
                                           type="password"
                                           id="Password"
                                           class="form-control"
                                           placeholder="Enter password"
                                           autocomplete="new-password" />

                                    <button class="btn btn-outline-secondary"
                                            type="button"
                                            id="togglePassword"
                                            aria-label="Show password">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>

                                <span asp-validation-for="Password"
                                      class="text-danger small"></span>

                                <div class="password-strength mt-2">
                                    <div class="progress rounded-pill" style="height: 5px;">
                                        <div id="passwordStrength"
                                             class="progress-bar"
                                             style="width: 0%;"></div>
                                    </div>

                                    <small id="passwordStrengthText"
                                           class="text-secondary">
                                        Password strength
                                    </small>
                                </div>
                            </div>

                            <!-- Confirm Password -->
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword"
                                       class="form-label fw-semibold">
                                    Confirm Password
                                </label>

                                <div class="input-group input-group-lg">
                                    <input asp-for="ConfirmPassword"
                                           type="password"
                                           id="ConfirmPassword"
                                           class="form-control"
                                           placeholder="Confirm password"
                                           autocomplete="new-password" />

                                    <button class="btn btn-outline-secondary"
                                            type="button"
                                            id="toggleConfirmPassword"
                                            aria-label="Show confirm password">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>

                                <span asp-validation-for="ConfirmPassword"
                                      class="text-danger small"></span>
                            </div>

                        </div>

                        <div class="alert alert-light border rounded-3 mt-4 mb-0 small">
                            <i class="fas fa-info-circle text-primary me-2"></i>
                            Use a strong password that meets the system's password requirements.
                        </div>
                    </div>
                </div>

            </div>

            <!-- Roles -->
            <div class="col-12 col-xl-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-header bg-transparent border-0 px-4 pt-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="section-icon bg-info bg-opacity-10 text-info">
                                <i class="fas fa-user-shield fa-lg"></i>
                            </div>

                            <div>
                                <h5 class="fw-bold mb-1">User Roles</h5>
                                <p class="text-secondary small mb-0">
                                    Configure account permissions.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fw-semibold small">Available Roles</span>

                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">
                                <span id="selectedRoleCount">0</span> Selected
                            </span>
                        </div>

                        @if (roles.Any())
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var role in roles)
                                {
                                    <label for="role_@role.Id"
                                           class="role-option border rounded-3 p-3 d-flex align-items-center gap-3">

                                        <input type="checkbox"
                                               name="SelectedRoles"
                                               value="@role.Name"
                                               id="role_@role.Id"
                                               class="form-check-input role-checkbox mt-0" />

                                        <div class="flex-grow-1">
                                            <div class="fw-semibold">@role.Name</div>
                                            <small class="text-secondary">System role</small>
                                        </div>

                                        <i class="fas fa-check-circle text-primary role-check-icon"></i>
                                    </label>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning rounded-3 mb-0">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                No roles are currently available.
                            </div>
                        }

                        <div class="alert alert-light border rounded-3 mt-4 mb-0 small">
                            <i class="fas fa-info-circle text-primary me-2"></i>
                            You can assign multiple roles to one user.
                            Choose only the roles this account needs.
                        </div>

                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                            <span class="text-secondary small">
                                <i class="fas fa-shield-alt text-success me-1"></i>
                                Review the information before creating the account.
                            </span>

                            <div class="d-flex gap-2">
                                <a asp-area="Admin"
                                   asp-controller="Admin"
                                   asp-action="Users"
                                   class="btn btn-light border rounded-3 px-4">
                                    Cancel
                                </a>

                                <button type="submit"
                                        class="btn btn-primary rounded-3 px-4">
                                    <i class="fas fa-user-plus me-2"></i>
                                    Create User
                                </button>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </form>
</div>

<style>
    .section-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .role-option {
        cursor: pointer;
        transition: all .2s ease;
        background: var(--bs-body-bg);
    }

        .role-option:hover,
        .role-option.selected {
            border-color: var(--bs-primary) !important;
            background: var(--bs-primary-bg-subtle);
        }

    .role-check-icon {
        opacity: 0;
        transition: opacity .2s ease;
    }

    .role-option.selected .role-check-icon {
        opacity: 1;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Role Selection
            const roleCheckboxes = document.querySelectorAll(".role-checkbox");
            const roleCountElement = document.getElementById("selectedRoleCount");

            function updateRoleSelection() {
                let count = 0;

                roleCheckboxes.forEach(function (element) {
                    if (!(element instanceof HTMLInputElement)) return;

                    const label = element.closest(".role-option");

                    if (element.checked) {
                        count++;
                        label?.classList.add("selected");
                    } else {
                        label?.classList.remove("selected");
                    }
                });

                if (roleCountElement) {
                    roleCountElement.textContent = count.toString();
                }
            }

            roleCheckboxes.forEach(function (element) {
                element.addEventListener("change", updateRoleSelection);
            });

            updateRoleSelection();

            // Show / Hide Password
            function setupPasswordToggle(buttonId: string, inputId: string) {
                const buttonElement = document.getElementById(buttonId);
                const inputElement = document.getElementById(inputId);

                if (!(buttonElement instanceof HTMLButtonElement)) return;
                if (!(inputElement instanceof HTMLInputElement)) return;

                const button = buttonElement;
                const input = inputElement;

                button.addEventListener("click", function () {
                    const showing = input.type === "text";

                    input.type = showing ? "password" : "text";

                    const icon = button.querySelector("i");

                    if (icon) {
                        icon.classList.toggle("fa-eye", showing);
                        icon.classList.toggle("fa-eye-slash", !showing);
                    }

                    button.setAttribute(
                        "aria-label",
                        showing ? "Show password" : "Hide password"
                    );
                });
            }

            setupPasswordToggle("togglePassword", "Password");
            setupPasswordToggle("toggleConfirmPassword", "ConfirmPassword");

            // Password Strength Indicator
            const passwordElement = document.getElementById("Password");
            const strengthElement = document.getElementById("passwordStrength");
            const strengthTextElement = document.getElementById("passwordStrengthText");

            if (
                passwordElement instanceof HTMLInputElement &&
                strengthElement instanceof HTMLElement &&
                strengthTextElement instanceof HTMLElement
            ) {
                const passwordInput = passwordElement;
                const strengthBar = strengthElement;
                const strengthText = strengthTextElement;

                passwordInput.addEventListener("input", function () {
                    const password = passwordInput.value;
                    let score = 0;

                    if (password.length >= 8) score++;
                    if (/[a-z]/.test(password)) score++;
                    if (/[A-Z]/.test(password)) score++;
                    if (/[0-9]/.test(password)) score++;
                    if (/[^a-zA-Z0-9]/.test(password)) score++;

                    strengthBar.style.width = (score / 5 * 100) + "%";

                    const levels = [
                        "Enter a password",
                        "Very Weak",
                        "Weak",
                        "Fair",
                        "Good",
                        "Strong"
                    ];

                    strengthText.textContent = levels[score];
                });
            }
        });
    </script>
}

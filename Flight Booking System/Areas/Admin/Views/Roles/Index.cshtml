@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    ViewData["Title"] = "Manage Roles";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="ltr">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="fas fa-user-shield text-primary me-2"></i>
                Manage Roles
            </h2>

            <p class="text-body-secondary mb-0">
                Create and manage system roles and access levels.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Roles"
           asp-action="Create"
           class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>
            Create Role
        </a>

    </div>

    <!-- Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Roles Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">

                    <div class="rounded-3 bg-primary bg-opacity-10 p-3">
                        <i class="fas fa-user-shield text-primary fs-4"></i>
                    </div>

                    <div>
                        <p class="text-body-secondary mb-1">
                            Total Roles
                        </p>

                        <h4 class="fw-bold mb-0">
                            @(Model?.Count() ?? 0)
                        </h4>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- Roles Table -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                <h5 class="fw-bold mb-0">
                    <i class="fas fa-list me-2 text-primary"></i>
                    Roles List
                </h5>

                <span class="text-body-secondary small">
                    Manage your system roles
                </span>

            </div>
        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 80px;">#</th>
                        <th>Role Name</th>
                        <th>Role ID</th>
                        <th class="text-center" style="width: 180px;">
                            Actions
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        var number = 1;

                        @foreach (var role in Model)
                        {
                            <tr>

                                <td class="ps-4 text-body-secondary">
                                    @number
                                </td>

                                <td>
                                    <div class="d-flex align-items-center gap-2">

                                        <div class="rounded-2 bg-primary bg-opacity-10 p-2">
                                            <i class="fas fa-user-tag text-primary"></i>
                                        </div>

                                        <span class="fw-semibold">
                                            @role.Name
                                        </span>

                                    </div>
                                </td>

                                <td>
                                    <small class="text-body-secondary">
                                        @role.Id
                                    </small>
                                </td>

                                <td class="text-center">

                                    @if (role.Name != "Admin")
                                    {
                                        <form asp-area="Admin"
                                              asp-controller="Roles"
                                              asp-action="Delete"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this role?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@role.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash-alt me-1"></i>
                                                Delete
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2">
                                            <i class="fas fa-lock me-1"></i>
                                            Protected
                                        </span>
                                    }

                                </td>

                            </tr>

                            number++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5">

                                <i class="fas fa-user-shield fs-1 text-body-secondary mb-3 d-block"></i>

                                <h6 class="fw-bold">
                                    No Roles Found
                                </h6>

                                <p class="text-body-secondary mb-3">
                                    There are no roles available in the system.
                                </p>

                                <a asp-area="Admin"
                                   asp-controller="Roles"
                                   asp-action="Create"
                                   class="btn btn-primary btn-sm">
                                    <i class="fas fa-plus me-1"></i>
                                    Create First Role
                                </a>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="card-footer bg-white py-3">
            <small class="text-body-secondary">
                Showing @(Model?.Count() ?? 0) role(s).
            </small>
        </div>

    </div>

</div>

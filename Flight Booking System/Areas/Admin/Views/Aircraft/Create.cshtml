```cshtml
@model Flight_Booking_System.Models.Aircraft
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Create Aircraft";
    Layout = "_AdminLayout";

    var airlines = ViewBag.Airlines as IEnumerable<Flight_Booking_System.Models.Airline>
        ?? Enumerable.Empty<Flight_Booking_System.Models.Airline>();
}

<div class="container">
    <h2 class="mb-4">Create Aircraft</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-area="Admin"
                  asp-controller="Aircraft"
                  asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="AirlineId" class="form-label">
                        Airline
                    </label>

                    <select asp-for="AirlineId"
                            class="form-select"
                            asp-items="@(new SelectList(airlines, "Id", "Name"))">
                        <option value="">-- Select Airline --</option>
                    </select>

                    <span asp-validation-for="AirlineId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="RegistrationNumber"
                           class="form-label"></label>

                    <input asp-for="RegistrationNumber"
                           class="form-control"
                           placeholder="Enter registration number" />

                    <span asp-validation-for="RegistrationNumber"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Model" class="form-label">
                        Aircraft Model
                    </label>

                    <input asp-for="Model"
                           class="form-control"
                           placeholder="e.g. Boeing 737" />

                    <span asp-validation-for="Model"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Capacity" class="form-label">
                        Total Seat Capacity
                    </label>

                    <input asp-for="Capacity"
                           type="number"
                           min="1"
                           class="form-control"
                           placeholder="Total seats in all classes" />

                    <span asp-validation-for="Capacity"
                          class="text-danger"></span>

                    <small class="form-text text-muted">
                        Total number of seats across all classes.
                    </small>
                </div>

                <button type="submit" class="btn btn-primary">
                    Save
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
```
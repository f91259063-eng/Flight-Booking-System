```cshtml
@model IEnumerable<Flight_Booking_System.Models.Aircraft>

@{
    ViewData["Title"] = "Aircraft";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="ltr">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-airplane me-1"></i>
                Manage Aircraft
            </h2>

            <p class="text-muted mb-0">
                View and manage aircraft, their information, and travel classes.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Aircraft"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add Aircraft
        </a>
    </div>

    <!-- Success and Error Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <!-- Aircraft Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold">Aircraft List</h5>
        </div>

        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle text-center mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Registration Number</th>
                                <th>Aircraft Model</th>
                                <th>Airline</th>
                                <th>Total Capacity</th>
                                <th style="min-width: 250px;">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                var counter = 1;
                            }

                            @foreach (var aircraft in Model)
                            {
                                <tr>
                                    <td>@counter</td>

                                    <td class="fw-semibold">
                                        @aircraft.RegistrationNumber
                                    </td>

                                    <td>@aircraft.Model</td>

                                    <td>
                                        @(aircraft.Airline?.Name ?? "Not specified")
                                    </td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @aircraft.Capacity Seats
                                        </span>
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-2 flex-wrap">

                                            <a asp-area="Admin"
                                               asp-controller="Aircraft"
                                               asp-action="Details"
                                               asp-route-id="@aircraft.Id"
                                               class="btn btn-sm btn-info text-white"
                                               title="View Details">
                                                <i class="bi bi-eye me-1"></i>
                                                Details
                                            </a>

                                            <a asp-area="Admin"
                                               asp-controller="Aircraft"
                                               asp-action="Edit"
                                               asp-route-id="@aircraft.Id"
                                               class="btn btn-sm btn-warning"
                                               title="Edit Aircraft">
                                                <i class="bi bi-pencil-square me-1"></i>
                                                Edit
                                            </a>

                                            <a asp-area="Admin"
                                               asp-controller="Aircraft"
                                               asp-action="Delete"
                                               asp-route-id="@aircraft.Id"
                                               class="btn btn-sm btn-danger"
                                               title="Delete Aircraft">
                                                <i class="bi bi-trash me-1"></i>
                                                Delete
                                            </a>

                                        </div>
                                    </td>
                                </tr>

                                counter++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-airplane display-4 text-muted"></i>

                    <h5 class="mt-3">No Aircraft Registered</h5>

                    <p class="text-muted">
                        Start by adding the first aircraft to the system.
                    </p>

                    <a asp-area="Admin"
                       asp-controller="Aircraft"
                       asp-action="Create"
                       class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>
                        Add Aircraft
                    </a>
                </div>
            }
        </div>
    </div>

</div>
```
```cshtml
@model IEnumerable<Flight_Booking_System.Models.Aircraft>

@{
    ViewData["Title"] = "Aircraft";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Aircraft Management</h2>

        <a asp-area="Admin"
           asp-controller="Aircraft"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Aircraft
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Airline</th>
                        <th>Registration Number</th>
                        <th>Model</th>
                        <th>Total Capacity</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var aircraft in Model)
                        {
                            <tr>
                                <td>@aircraft.Id</td>
                                <td>
                                    @(aircraft.Airline?.Name ?? "N/A")
                                </td>
                                <td>@aircraft.RegistrationNumber</td>
                                <td>@aircraft.Model</td>
                                <td>@aircraft.Capacity</td>

                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Edit"
                                           asp-route-id="@aircraft.Id"
                                           class="btn btn-sm btn-warning">
                                            Edit
                                        </a>

                                        <a asp-action="Details"
                                           asp-route-id="@aircraft.Id"
                                           class="btn btn-sm btn-info">
                                            Details
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@aircraft.Id"
                                           class="btn btn-sm btn-danger">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">
                                No aircraft found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
```
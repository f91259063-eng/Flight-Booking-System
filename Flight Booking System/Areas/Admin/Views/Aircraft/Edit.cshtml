@model Flight_Booking_System.Models.Aircraft

@{
    ViewData["Title"] = "Edit Aircraft";
    Layout = "_AdminLayout";

    var airlines = ViewBag.Airlines as IEnumerable<Flight_Booking_System.Models.Airline>
        ?? Enumerable.Empty<Flight_Booking_System.Models.Airline>();
}

<div class="container">
    <h2 class="mb-4">Edit Aircraft</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-area="Admin"
                  asp-controller="Aircraft"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="AirlineId" class="form-label">
                        Airline
                    </label>

                    <select asp-for="AirlineId"
                            class="form-select"
                            asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(airlines, "Id", "Name", Model.AirlineId))">
                        <option value="">-- Select Airline --</option>
                    </select>

                    <span asp-validation-for="AirlineId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="RegistrationNumber"
                           class="form-label"></label>

                    <input asp-for="RegistrationNumber"
                           class="form-control" />

                    <span asp-validation-for="RegistrationNumber"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Model" class="form-label">
                        Aircraft Model
                    </label>

                    <input asp-for="Model" class="form-control" />

                    <span asp-validation-for="Model"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Capacity" class="form-label">
                        Total Seat Capacity
                    </label>

                    <input asp-for="Capacity"
                           type="number"
                           min="1"
                           class="form-control" />

                    <span asp-validation-for="Capacity"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success">
                    Save Changes
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

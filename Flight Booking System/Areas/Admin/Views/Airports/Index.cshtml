
@model IEnumerable<Flight_Booking_System.Models.AirPort>

@{
    ViewData["Title"] = "Airports";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="ltr">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Manage Airports</h2>
            <p class="text-muted mb-0">
                View and manage airport information and coordinates.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Airports"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add New Airport
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Airports List</h5>
        </div>

        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info mb-0">
                    No airports have been registered yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">

                        <thead style="background-color: #0b1729; color: white;">
                            <tr>
                                <th>ID</th>
                                <th>Airport Name</th>
                                <th>City</th>
                                <th>Latitude</th>
                                <th>Longitude</th>
                                <th>Coordinates Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var airport in Model)
                            {
                                <tr>
                                    <td>@airport.Id</td>

                                    <td class="fw-semibold">
                                        @airport.Name
                                    </td>

                                    <td>
                                        @(airport.City?.Name ?? "Not specified")
                                    </td>

                                    <td dir="ltr">
                                        @(airport.Latitude?.ToString("F6") ?? "Not available")
                                    </td>

                                    <td dir="ltr">
                                        @(airport.Longitude?.ToString("F6") ?? "Not available")
                                    </td>

                                    <td>
                                        @if (airport.Latitude.HasValue &&
                                             airport.Longitude.HasValue)
                                        {
                                            <span class="badge bg-success">
                                                Coordinates Available
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Coordinates Missing
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-2">

                                            <a asp-area="Admin"
                                               asp-controller="Airports"
                                               asp-action="Edit"
                                               asp-route-id="@airport.Id"
                                               class="btn btn-warning btn-sm">
                                                <i class="bi bi-pencil-square me-1"></i>
                                                Edit
                                            </a>

                                            <form asp-area="Admin"
                                                  asp-controller="Airports"
                                                  asp-action="Delete"
                                                  asp-route-id="@airport.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this airport?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm">
                                                    <i class="bi bi-trash me-1"></i>
                                                    Delete
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
        </div>
    </div>
</div>

@model IEnumerable<Flight_Booking_System.Models.Airline>

@{
    ViewData["Title"] = "Airlines";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="ltr">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Airlines</h2>
            <p class="text-muted mb-0">
                Manage airline information.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Airline"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add Airline
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Airlines List</h5>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead style="background-color: #0b1729; color: white;">
                        <tr>
                            <th>Airline Name</th>
                            <th>Airline Code</th>
                            <th>Email Address</th>
                            <th>Phone Number</th>
                            <th class="text-center" style="width: 220px;">
                                Actions
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var airline in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @airline.Name
                                    </td>

                                    <td>
                                        @airline.AirlineCode
                                    </td>

                                    <td dir="ltr">
                                        @airline.Email
                                    </td>

                                    <td dir="ltr">
                                        @airline.Phone
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-2">

                                            <a asp-area="Admin"
                                               asp-controller="Airline"
                                               asp-action="Edit"
                                               asp-route-id="@airline.Id"
                                               class="btn btn-warning btn-sm">
                                                <i class="bi bi-pencil-square"></i>
                                                Edit
                                            </a>

                                            <a asp-area="Admin"
                                               asp-controller="Airline"
                                               asp-action="Delete"
                                               asp-route-id="@airline.Id"
                                               class="btn btn-danger btn-sm">
                                                <i class="bi bi-trash"></i>
                                                Delete
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center py-4 text-muted">
                                    No airlines have been registered yet.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>

</div>

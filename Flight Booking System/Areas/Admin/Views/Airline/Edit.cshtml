@model Flight_Booking_System.Models.Airline

@{
    ViewData["Title"] = "Edit Airline";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="ltr">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Edit Airline</h2>
            <p class="text-muted mb-0">
                Update the airline information.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Airline"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Airlines
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Airline Information</h5>
                </div>

                <div class="card-body p-4">

                    <form asp-area="Admin"
                          asp-controller="Airline"
                          asp-action="Edit"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">
                                Airline Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter airline name" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AirlineCode" class="form-label fw-semibold">
                                Airline Code
                            </label>

                            <input asp-for="AirlineCode"
                                   class="form-control"
                                   placeholder="Enter airline code" />

                            <span asp-validation-for="AirlineCode"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   dir="ltr"
                                   class="form-control"
                                   placeholder="example@email.com" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Phone" class="form-label fw-semibold">
                                Phone Number
                            </label>

                            <input asp-for="Phone"
                                   type="tel"
                                   dir="ltr"
                                   maxlength="11"
                                   minlength="11"
                                   class="form-control"
                                   placeholder="Enter phone number" />

                            <span asp-validation-for="Phone"
                                  class="text-danger">
                            </span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-start gap-2">

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i>
                                Save Changes
                            </button>

                            <a asp-area="Admin"
                               asp-controller="Airline"
                               asp-action="Index"
                               class="btn btn-light border">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

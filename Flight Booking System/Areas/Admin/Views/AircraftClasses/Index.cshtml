@model IEnumerable<Flight_Booking_System.Models.AircraftClass>

@{
    ViewData["Title"] = "Aircraft Classes";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Aircraft Classes</h2>

        <a asp-controller="AircraftClasses"
           asp-action="Create"
           class="btn btn-primary">
            <i class="fas fa-plus"></i> Add Aircraft Class
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Aircraft</th>
                            <th>Class</th>
                            <th>Seat Count</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.ID</td>
                                    <td>@item.Aircraft.RegistrationNumber</td>
                                    <td>@item.Class.Name</td>
                                    <td>@item.NumberOfSeats</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">
                                    No aircraft classes found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
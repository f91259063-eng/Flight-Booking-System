
@model Flight_Booking_System.Models.Class

@{
    ViewData["Title"] = "Delete Travel Class";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="ltr">

    <div class="mb-4">
        <h2 class="fw-bold">Delete Travel Class</h2>
        <p class="text-muted">
            Review the travel class information before deleting it.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Travel Class Information</h5>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-warning">
                        Are you sure you want to delete this travel class?
                    </div>

                    <dl class="row">
                        <dt class="col-sm-5">ID</dt>
                        <dd class="col-sm-7">@Model.Id</dd>

                        <dt class="col-sm-5">Travel Class Name</dt>
                        <dd class="col-sm-7">@Model.Name</dd>

                        <dt class="col-sm-5">Price Multiplier</dt>
                        <dd class="col-sm-7">
                            @Model.DistancePercentage.ToString("0.00")
                        </dd>
                    </dl>

                    <form asp-area="Admin"
                          asp-controller="Class"
                          asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                Confirm Delete
                            </button>

                            <a asp-area="Admin"
                               asp-controller="Class"
                               asp-action="Index"
                               class="btn btn-light border">
                                Cancel
                            </a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
```

@model Flight_Booking_System.Models.Class

@{
    ViewData["Title"] = "Add Travel Class";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="ltr">

    <div class="mb-4">
        <h2 class="fw-bold">Add New Travel Class</h2>
        <p class="text-muted">
            Enter the travel class name and its price multiplier.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Travel Class Information</h5>
                </div>

                <div class="card-body p-4">
                    <form asp-area="Admin"
                          asp-controller="Class"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                                Travel Class Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="e.g. Economy, Business, First Class" />

                            <span asp-validation-for="Name"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DistancePercentage"
                                   class="form-label fw-semibold">
                                Price Multiplier
                            </label>

                            <input asp-for="DistancePercentage"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   class="form-control"
                                   placeholder="e.g. 1.00, 1.25, 1.50" />

                            <span asp-validation-for="DistancePercentage"
                                  class="text-danger"></span>

                            <small class="text-muted">
                                Example: 1.00 = standard price, 1.25 = 25% higher,
                                1.50 = 50% higher.
                            </small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                Save
                            </button>

                            <a asp-area="Admin"
                               asp-controller="Class"
                               asp-action="Index"
                               class="btn btn-light border">
                                Cancel
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
```
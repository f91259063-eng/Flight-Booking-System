@model IEnumerable<Flight_Booking_System.Models.Class>

@{
    ViewData["Title"] = "درجات السفر";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="rtl">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">درجات السفر</h2>
            <p class="text-muted mb-0">
                إدارة درجات السفر المتاحة في نظام حجز الطيران
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Class"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            إضافة درجة سفر
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">قائمة درجات السفر</h5>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead style="background-color: #0b1729; color: white;">
                        <tr>
                            <th class="text-center">الرقم</th>
                            <th>درجة السفر</th>
                            <th class="text-center">الإجراءات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">@item.Id</td>

                                    <td class="fw-semibold">
                                        @if (item.Name == "Economy")
                                        {
                                            <span>اقتصادي (Economy)</span>
                                        }
                                        else if (item.Name == "Business")
                                        {
                                            <span>رجال الأعمال (Business)</span>
                                        }
                                        else
                                        {
                                            @item.Name
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-2">

                                            <a asp-area="Admin"
                                               asp-controller="Class"
                                               asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-warning btn-sm">
                                                تعديل
                                            </a>

                                            <a asp-area="Admin"
                                               asp-controller="Class"
                                               asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-danger btn-sm">
                                                حذف
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3"
                                    class="text-center py-4 text-muted">
                                    لا توجد درجات سفر مسجلة حتى الآن.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>
</div>

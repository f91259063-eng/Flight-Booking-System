
@model IEnumerable<Flight_Booking_System.Models.Class>

@{
    ViewData["Title"] = "Travel Classes";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="ltr">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Travel Classes</h2>
            <p class="text-muted mb-0">
                Manage the available travel classes in the flight booking system.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Class"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add Travel Class
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Travel Classes List</h5>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead style="background-color: #0b1729; color: white;">
                        <tr>
                            <th>Travel Class</th>
                            <th class="text-center">Price Multiplier</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @item.Name
                                    </td>

                                    <td class="text-center">
                                        @item.DistancePercentage.ToString("0.00")
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-2">

                                            <a asp-area="Admin"
                                               asp-controller="Class"
                                               asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-warning btn-sm">
                                                Edit
                                            </a>

                                            <a asp-area="Admin"
                                               asp-controller="Class"
                                               asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-danger btn-sm">
                                                Delete
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3"
                                    class="text-center py-4 text-muted">
                                    No travel classes have been added yet.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>
</div>

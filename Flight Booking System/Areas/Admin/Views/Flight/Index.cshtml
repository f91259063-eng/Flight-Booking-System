@model IEnumerable<Flight_Booking_System.Models.Flight>
@using Flight_Booking_System.Models.ENUM

@{
    ViewData["Title"] = "Manage Flights";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Manage Flights</h4>

            <a asp-area="Admin"
               asp-controller="Flight"
               asp-action="Create"
               class="btn btn-primary">
                Add New Flight
            </a>
        </div>

        <div class="card-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            <div class="table-responsive">
                <table class="table table-bordered table-hover text-center align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Flight Number</th>
                            <th>Aircraft ID</th>
                            <th>Airline</th>
                            <th>Route ID</th>
                            <th>Departure Date & Time</th>
                            <th>Arrival Date & Time</th>
                            <th>Day of Week</th>
                            <th>Flight Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            var count = 1;

                            @foreach (var flight in Model)
                            {
                                <tr>
                                    <td>@count</td>

                                    <td>@flight.FlightNumber</td>

                                    <td>@flight.AircraftId</td>

                                    <td>@flight.Airline?.Name</td>

                                    <td>@flight.RouteId</td>

                                    <td>
                                        @flight.DepartureDateTime.ToString("yyyy/MM/dd HH:mm")
                                    </td>

                                    <td>
                                        @flight.ArrivalDateTime.ToString("yyyy/MM/dd HH:mm")
                                    </td>

                                    <td>
                                        @{
                                            var day = flight.DayOfWeek switch
                                            {
                                                DayOfWeek.Saturday => "Saturday",
                                                DayOfWeek.Sunday => "Sunday",
                                                DayOfWeek.Monday => "Monday",
                                                DayOfWeek.Tuesday => "Tuesday",
                                                DayOfWeek.Wednesday => "Wednesday",
                                                DayOfWeek.Thursday => "Thursday",
                                                DayOfWeek.Friday => "Friday",
                                                _ => "Undefined"
                                            };
                                        }

                                        @day
                                    </td>

                                    <td>
                                        @switch (flight.FlightStatus)
                                        {
                                            case FlightStatus.Scheduled:
                                                <span class="badge bg-success">Scheduled</span>
                                                break;

                                            case FlightStatus.InProgress:
                                                <span class="badge bg-primary">In Progress</span>
                                                break;

                                            case FlightStatus.Completed:
                                                <span class="badge bg-info">Completed</span>
                                                break;

                                            case FlightStatus.Cancelled:
                                                <span class="badge bg-danger">Cancelled</span>
                                                break;

                                            default:
                                                <span class="badge bg-secondary">Undefined</span>
                                                break;
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex gap-1 justify-content-center">

                                            <a asp-area="Admin"
                                               asp-controller="Flight"
                                               asp-action="Edit"
                                               asp-route-id="@flight.Id"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            <a asp-area="Admin"
                                               asp-controller="Flight"
                                               asp-action="Delete"
                                               asp-route-id="@flight.Id"
                                               class="btn btn-sm btn-danger">
                                                Delete
                                            </a>

                                        </div>
                                    </td>
                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10">
                                    No flights have been registered yet.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
</div>

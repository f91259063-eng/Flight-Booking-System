@model Flight_Booking_System.Models.Flight

@using Flight_Booking_System.Models.ENUM

@{
    ViewData["Title"] = "Edit Flight";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4 flight-management">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <div class="text-muted small mb-2">
                Flight Operations / Flights / Edit
            </div>

            <h2 class="fw-bold mb-1">Edit Flight</h2>

            <p class="text-muted mb-0">
                Update flight information, route and schedule details.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Flight"
           asp-action="Index"
           class="btn btn-light border px-3">

            <i class="bi bi-arrow-left me-2"></i>
            Back to Flights

        </a>

    </div>

    <!-- Edit Flight Card -->
    <div class="card border-0 shadow-sm flight-form-card">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex align-items-center gap-3">

                <div class="flight-form-header-icon">
                    <i class="bi bi-pencil-square"></i>
                </div>

                <div>
                    <h5 class="fw-bold mb-1">Flight Information</h5>

                    <p class="text-muted small mb-0">
                        Modify the flight details below.
                    </p>
                </div>

            </div>

        </div>

        <div class="card-body p-4">

            <form asp-area="Admin"
                  asp-controller="Flight"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert">
                </div>

                <!-- Basic Information -->
                <div class="flight-form-section mb-4">

                    <div class="flight-section-title mb-3">
                        <i class="bi bi-info-circle"></i>
                        <span>Basic Information</span>
                    </div>

                    <div class="row g-4">

                        <div class="col-12 col-md-6">

                            <label asp-for="FlightNumber" class="form-label fw-semibold">
                                Flight Number
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="FlightNumber"
                                   class="form-control"
                                   placeholder="Enter flight number" />

                            <span asp-validation-for="FlightNumber"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="col-12 col-md-6">

                            <label asp-for="FlightStatus" class="form-label fw-semibold">
                                Flight Status
                                <span class="text-danger">*</span>
                            </label>

                            <select asp-for="FlightStatus" class="form-select">

                                <option value="@((int)FlightStatus.Scheduled)">
                                    Scheduled
                                </option>

                                <option value="@((int)FlightStatus.InProgress)">
                                    In Progress
                                </option>

                                <option value="@((int)FlightStatus.Completed)">
                                    Completed
                                </option>

                                <option value="@((int)FlightStatus.Cancelled)">
                                    Cancelled
                                </option>

                            </select>

                            <span asp-validation-for="FlightStatus"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                </div>

                <hr class="my-4" />

                <!-- Aircraft and Airline -->
                <div class="flight-form-section mb-4">

                    <div class="flight-section-title mb-3">
                        <i class="bi bi-airplane-engines"></i>
                        <span>Aircraft & Airline</span>
                    </div>

                    <div class="row g-4">

                        <div class="col-12 col-md-6">

                            <label asp-for="AircraftId" class="form-label fw-semibold">
                                Aircraft
                                <span class="text-danger">*</span>
                            </label>

                            <select asp-for="AircraftId"
                                    asp-items="ViewBag.Aircrafts"
                                    class="form-select">

                                <option value="">-- Select Aircraft --</option>

                            </select>

                            <span asp-validation-for="AircraftId"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="col-12 col-md-6">

                            <label asp-for="AirlineId" class="form-label fw-semibold">
                                Airline
                                <span class="text-danger">*</span>
                            </label>

                            <select asp-for="AirlineId"
                                    asp-items="ViewBag.Airlines"
                                    class="form-select">

                                <option value="">-- Select Airline --</option>

                            </select>

                            <span asp-validation-for="AirlineId"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                </div>

                <hr class="my-4" />

                <!-- Route Information -->
                <div class="flight-form-section mb-4">

                    <div class="flight-section-title mb-3">
                        <i class="bi bi-signpost-split"></i>
                        <span>Route Information</span>
                    </div>

                    <div class="row g-4">

                        <div class="col-12 col-md-6">

                            <label asp-for="RouteId" class="form-label fw-semibold">
                                Flight Route
                                <span class="text-danger">*</span>
                            </label>

                            <select asp-for="RouteId"
                                    asp-items="ViewBag.Routes"
                                    class="form-select">

                                <option value="">-- Select Route --</option>

                            </select>

                            <span asp-validation-for="RouteId"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="col-12 col-md-6">

                            <label asp-for="DayOfWeek" class="form-label fw-semibold">
                                Day of Week
                                <span class="text-danger">*</span>
                            </label>

                            <select asp-for="DayOfWeek"
                                    asp-items="Html.GetEnumSelectList<DayOfWeek>()"
                                    class="form-select">
                            </select>

                            <span asp-validation-for="DayOfWeek"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                </div>

                <hr class="my-4" />

                <!-- Flight Schedule -->
                <div class="flight-form-section mb-4">

                    <div class="flight-section-title mb-3">
                        <i class="bi bi-calendar-event"></i>
                        <span>Flight Schedule</span>
                    </div>

                    <div class="row g-4">

                        <div class="col-12 col-md-6">

                            <label asp-for="DepartureDateTime"
                                   class="form-label fw-semibold">

                                Departure Date & Time
                                <span class="text-danger">*</span>

                            </label>

                            <input asp-for="DepartureDateTime"
                                   type="datetime-local"
                                   class="form-control" />

                            <span asp-validation-for="DepartureDateTime"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="col-12 col-md-6">

                            <label asp-for="ArrivalDateTime"
                                   class="form-label fw-semibold">

                                Arrival Date & Time
                                <span class="text-danger">*</span>

                            </label>

                            <input asp-for="ArrivalDateTime"
                                   type="datetime-local"
                                   class="form-control" />

                            <span asp-validation-for="ArrivalDateTime"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                </div>

                <!-- Form Actions -->
                <div class="d-flex flex-wrap justify-content-end gap-2 mt-5">

                    <a asp-area="Admin"
                       asp-controller="Flight"
                       asp-action="Index"
                       class="btn btn-light border px-4">

                        Cancel

                    </a>

                    <button type="submit" class="btn btn-warning px-4">

                        <i class="bi bi-check-lg me-2"></i>
                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}

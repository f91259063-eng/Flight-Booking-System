@model Flight_Booking_System.Models.Flight

@{
    ViewData["Title"] = "Delete Flight";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    <div class="card shadow-sm border-danger flight-form-card">

        <div class="card-header bg-danger text-white p-4">
            <div class="d-flex align-items-center gap-3">
                <div class="flight-form-header-icon bg-white text-danger">
                    <i class="bi bi-trash"></i>
                </div>

                <div>
                    <h4 class="mb-1">Delete Flight</h4>
                    <p class="mb-0 small opacity-75">
                        Review flight details before confirming deletion.
                    </p>
                </div>
            </div>
        </div>

        <div class="card-body p-4">

            <div class="alert alert-warning d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <span>
                    Are you sure you want to delete this flight?
                    This action cannot be undone.
                </span>
            </div>

            <h5 class="flight-section-title mb-4">
                <i class="bi bi-airplane"></i>
                Flight Information
            </h5>

            <dl class="row mb-4">

                <dt class="col-md-3 col-sm-4 mb-2">Flight Number</dt>
                <dd class="col-md-9 col-sm-8 mb-3">
                    @Model.FlightNumber
                </dd>

                <dt class="col-md-3 col-sm-4 mb-2">Aircraft ID</dt>
                <dd class="col-md-9 col-sm-8 mb-3">
                    @Model.AircraftId
                </dd>

                <dt class="col-md-3 col-sm-4 mb-2">Airline</dt>
                <dd class="col-md-9 col-sm-8 mb-3">
                    @(Model.Airline?.Name ?? "N/A")
                </dd>

                <dt class="col-md-3 col-sm-4 mb-2">Route ID</dt>
                <dd class="col-md-9 col-sm-8 mb-3">
                    @Model.RouteId
                </dd>

                <dt class="col-md-3 col-sm-4 mb-2">Departure Date & Time</dt>
                <dd class="col-md-9 col-sm-8 mb-3">
                    @Model.DepartureDateTime.ToString("yyyy/MM/dd HH:mm")
                </dd>

                <dt class="col-md-3 col-sm-4 mb-2">Arrival Date & Time</dt>
                <dd class="col-md-9 col-sm-8 mb-3">
                    @Model.ArrivalDateTime.ToString("yyyy/MM/dd HH:mm")
                </dd>

            </dl>

            <hr />

            <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">

                <a asp-area="Admin"
                   asp-controller="Flight"
                   asp-action="Index"
                   class="btn btn-light border">
                    <i class="bi bi-x-circle me-1"></i>
                    Cancel
                </a>

                <form asp-area="Admin"
                      asp-controller="Flight"
                      asp-action="Delete"
                      asp-route-id="@Model.Id"
                      method="post">

                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>
                        Confirm Delete
                    </button>

                </form>

            </div>

        </div>
    </div>
</div>

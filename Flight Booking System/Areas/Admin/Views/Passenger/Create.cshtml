@model Flight_Booking_System.Models.Passenger

@{
    ViewData["Title"] = "Add New Passenger";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="ltr">

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-person-plus me-1"></i>
            Add New Passenger
        </h2>

        <p class="text-muted mb-0">
            Enter the passenger's personal and contact information.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="card border-0 shadow-sm">

                <!-- Card Header -->
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-person-vcard me-1"></i>
                        Passenger Information
                    </h5>
                </div>

                <div class="card-body p-4">

                    <form asp-area="Admin"
                          asp-controller="Passenger"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- Personal Information -->
                        <h6 class="fw-bold text-primary mb-3">
                            <i class="bi bi-person me-1"></i>
                            Personal Information
                        </h6>

                        <div class="row">

                            <div class="col-md-4 mb-3">
                                <label asp-for="FirstName" class="form-label">
                                    First Name
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control"
                                       placeholder="Enter first name" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="MiddleName" class="form-label">
                                    Middle Name
                                </label>

                                <input asp-for="MiddleName"
                                       class="form-control"
                                       placeholder="Enter middle name" />

                                <span asp-validation-for="MiddleName"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="LastName" class="form-label">
                                    Last Name
                                </label>

                                <input asp-for="LastName"
                                       class="form-control"
                                       placeholder="Enter last name" />

                                <span asp-validation-for="LastName"
                                      class="text-danger"></span>
                            </div>

                        </div>

                        <hr class="my-3" />

                        <!-- Identification Details -->
                        <h6 class="fw-bold text-primary mb-3">
                            <i class="bi bi-card-text me-1"></i>
                            Identification Details
                        </h6>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="PassportNumber" class="form-label">
                                    Passport Number
                                </label>

                                <input asp-for="PassportNumber"
                                       class="form-control"
                                       dir="ltr"
                                       placeholder="Enter passport number" />

                                <span asp-validation-for="PassportNumber"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="NationalID" class="form-label">
                                    National ID
                                </label>

                                <input asp-for="NationalID"
                                       class="form-control"
                                       dir="ltr"
                                       maxlength="14"
                                       inputmode="numeric"
                                       placeholder="Enter 14-digit National ID" />

                                <span asp-validation-for="NationalID"
                                      class="text-danger"></span>
                            </div>

                        </div>

                        <hr class="my-3" />

                        <!-- Contact Information -->
                        <h6 class="fw-bold text-primary mb-3">
                            <i class="bi bi-telephone me-1"></i>
                            Contact Information
                        </h6>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="Phone" class="form-label">
                                    Phone Number
                                </label>

                                <input asp-for="Phone"
                                       class="form-control"
                                       dir="ltr"
                                       maxlength="11"
                                       inputmode="numeric"
                                       placeholder="Enter phone number"
                                       oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 11)" />

                                <span asp-validation-for="Phone"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label">
                                    Email Address
                                </label>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       dir="ltr"
                                       placeholder="Enter email address" />

                                <span asp-validation-for="Email"
                                      class="text-danger"></span>
                            </div>

                        </div>

                        <hr class="my-3" />

                        <!-- Date of Birth -->
                        <h6 class="fw-bold text-primary mb-3">
                            <i class="bi bi-calendar-date me-1"></i>
                            Date of Birth
                        </h6>

                        <div class="mb-4">
                            <label asp-for="DateOfBirth" class="form-label">
                                Date of Birth
                            </label>

                            <input asp-for="DateOfBirth"
                                   type="date"
                                   class="form-control"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")" />

                            <span asp-validation-for="DateOfBirth"
                                  class="text-danger"></span>
                        </div>

                        <!-- Form Actions -->
                        <div class="d-flex gap-2 flex-wrap">

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-1"></i>
                                Save Passenger
                            </button>

                            <a asp-area="Admin"
                               asp-controller="Passenger"
                               asp-action="Index"
                               class="btn btn-light border">
                                <i class="bi bi-arrow-left me-1"></i>
                                Back to Passenger List
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

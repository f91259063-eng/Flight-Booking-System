﻿
@model Flight_Booking_System.ViewModels.Customer.PassengerBookingViewModel

@{
    ViewData["Title"] = "Passenger Details";
    Layout = "~/Areas/Customer/Views/Shared/_CustomerLayout.cshtml";

    var subtotal = Model == null
        ? 0m
        : Model.TicketPrice * (Model.Passengers?.Count ?? 0);
}

@if (Model == null)
{
    <div class="container py-4">
        <div class="alert alert-danger">
            Passenger information could not be loaded.
            Please return to seat selection and try again.
        </div>

        <a asp-area="Customer"
           asp-controller="Flights"
           asp-action="Index"
           class="btn btn-primary">
            Return to Available Flights
        </a>
﻿
@model Flight_Booking_System.Models.Passenger

@{
    ViewData["Title"] = "Add Passenger";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="ltr">

    <!-- Header -->
    <div class="mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-person-plus me-1"></i>
            Add New Passenger
        </h2>
        <p class="text-muted">
            Enter the passenger's information to save it in the system.
        </p>
    </div>
}
else
{
    <div class="container py-4">

        <div class="mb-4">
            <h2 class="fw-bold">Passenger Details</h2>
            <p class="text-muted">
                Enter passenger details for each selected seat.
                Search for an existing passenger using passport number or national ID.
            </p>
        </div>

        <form asp-area="Customer"
              asp-controller="Passenger"
              asp-action="Create"
              method="post"
              id="passengerForm"
              data-search-url="@Url.Action("SearchPassenger", "Passenger", new { area = "Customer" })">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="FlightId" />
            <input type="hidden" asp-for="ClassId" />
            <input type="hidden" asp-for="TicketPrice" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            @if (Model.Passengers == null || !Model.Passengers.Any())
            {
                <div class="alert alert-warning">
                    No seats selected. Please return and select your seats.
                </div>

                <a asp-area="Customer"
                   asp-controller="Flights"
                   asp-action="Index"
                   class="btn btn-primary">
                    Return to Available Flights
                </a>
            }
            else
            {
                @for (int i = 0; i < Model.Passengers.Count; i++)
                {
                    <div class="card shadow-sm mb-4 passenger-card">

                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                Passenger @(i + 1) - Seat @Model.Passengers[i].SeatNumber
                            </h5>
                        </div>

                        <div class="card-body">

                            <input type="hidden"
                                   asp-for="Passengers[i].SeatId" />

                            <input type="hidden"
                                   asp-for="Passengers[i].SeatNumber" />

                            <input type="hidden"
                                   asp-for="Passengers[i].SelectedPassengerId"
                                   class="selected-passenger-id" />

                            <div class="border rounded p-3 mb-4 bg-light">

                                <h6 class="fw-bold mb-3">
                                    Search Existing Passenger
                                </h6>

                                <div class="row g-3">

                                    <div class="col-md-5">
                                        <label for="search-passport-@i"
                                               class="form-label">
                                            Passport Number
                                        </label>

                                        <input type="text"
                                               id="search-passport-@i"
                                               class="form-control search-passport"
                                               placeholder="Enter passport number"
                                               autocomplete="off" />
                                    </div>

                                    <div class="col-md-5">
                                        <label for="search-national-id-@i"
                                               class="form-label">
                                            National ID
                                        </label>

                                        <input type="text"
                                               id="search-national-id-@i"
                                               class="form-control search-national-id"
                                               placeholder="Enter national ID"
                                               autocomplete="off"
                                               inputmode="numeric" />
                                    </div>

                                    <div class="col-md-2 d-flex align-items-end">
                                        <button type="button"
                                                class="btn btn-primary w-100 search-passenger-btn">
                                            Search
                                        </button>
                                    </div>

                                </div>

                                <div class="mt-3 d-flex gap-2 flex-wrap">

                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm clear-passenger-btn">
                                        Clear Passenger
                                    </button>

                                    <span class="small text-muted align-self-center search-message"
                                          role="status"
                                          aria-live="polite">
                                        Enter a passport number or national ID to search.
                                    </span>

                                </div>
                            </div>

                            <div class="row g-3">

                                <div class="col-md-4">
                                    <label asp-for="Passengers[i].FirstName"
                                           class="form-label">
                                        First Name
                                    </label>

                                    <input asp-for="Passengers[i].FirstName"
                                           class="form-control passenger-first-name" />

                                    <span asp-validation-for="Passengers[i].FirstName"
                                          class="text-danger"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="Passengers[i].MiddleName"
                                           class="form-label">
                                        Middle Name
                                    </label>

                                    <input asp-for="Passengers[i].MiddleName"
                                           class="form-control passenger-middle-name" />

                                    <span asp-validation-for="Passengers[i].MiddleName"
                                          class="text-danger"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="Passengers[i].LastName"
                                           class="form-label">
                                        Last Name
                                    </label>

                                    <input asp-for="Passengers[i].LastName"
                                           class="form-control passenger-last-name" />

                                    <span asp-validation-for="Passengers[i].LastName"
                                          class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Passengers[i].PassportNumber"
                                           class="form-label">
                                        Passport Number
                                    </label>

                                    <input asp-for="Passengers[i].PassportNumber"
                                           class="form-control passenger-passport" />

                                    <span asp-validation-for="Passengers[i].PassportNumber"
                                          class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Passengers[i].NationalID"
                                           class="form-label">
                                        National ID
                                    </label>

                                    <input asp-for="Passengers[i].NationalID"
                                           class="form-control passenger-national-id" />

                                    <span asp-validation-for="Passengers[i].NationalID"
                                          class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Passengers[i].Phone"
                                           class="form-label">
                                        Phone
                                    </label>

                                    <input asp-for="Passengers[i].Phone"
                                           class="form-control passenger-phone"
                                           type="tel" />

                                    <span asp-validation-for="Passengers[i].Phone"
                                          class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Passengers[i].Email"
                                           class="form-label">
                                        Email
                                    </label>

                                    <input asp-for="Passengers[i].Email"
                                           class="form-control passenger-email"
                                           type="email" />

                                    <span asp-validation-for="Passengers[i].Email"
                                          class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Passengers[i].DateOfBirth"
                                           class="form-label">
                                        Date of Birth
                                    </label>

                                    <input asp-for="Passengers[i].DateOfBirth"
                                           class="form-control passenger-date-of-birth"
                                           type="date"
                                           asp-format="{0:yyyy-MM-dd}" />

                                    <span asp-validation-for="Passengers[i].DateOfBirth"
                                          class="text-danger"></span>
                                </div>

    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Passenger Information</h5>
                </div>

                <div class="card-body p-4">

                    <form asp-area="Admin"
                          asp-controller="Passenger"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- Passenger Name -->
                        <div class="row">

                            <div class="col-md-4 mb-3">
                                <label asp-for="FirstName" class="form-label">
                                    First Name
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="MiddleName" class="form-label">
                                    Middle Name
                                </label>

                                <input asp-for="MiddleName"
                                       class="form-control" />

                                <span asp-validation-for="MiddleName"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="LastName" class="form-label">
                                    Last Name
                                </label>

                                <input asp-for="LastName"
                                       class="form-control" />

                                <span asp-validation-for="LastName"
                                      class="text-danger"></span>
                            </div>

                        </div>
                    </div>
                }

                <!-- Booking Summary -->

                <div class="card shadow-sm mb-4">
                    <div class="card-body">

                        <h4 class="fw-bold mb-3">
                            Booking Summary
                        </h4>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Number of Passengers</span>
                            <strong>@Model.Passengers.Count</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Price per Ticket</span>
                            <strong>@Model.TicketPrice.ToString("N2") EGP</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal</span>
                            <strong id="subtotal">
                                @subtotal.ToString("N2")
                            </strong>
                        </div>

                        <hr />

                        <!-- Reward Points -->

                        <div class="bg-light border rounded p-3 mb-4">

                            <h5 class="fw-bold mb-3">
                                Reward Points
                            </h5>

                            <div class="alert alert-info">
                                Your available points:
                                <strong id="availablePoints">
                                    @Model.AvailablePoints
                                </strong>
                            </div>

                            <div class="row g-3 align-items-end">

                                <div class="col-md-6">

                                    <label asp-for="PointsToRedeem"
                                           class="form-label fw-bold">
                                        Points to Redeem
                                    </label>

                                    <input asp-for="PointsToRedeem"
                                           type="number"
                                           min="0"
                                           max="@Model.AvailablePoints"
                                           step="100"
                                           value="0"
                                           class="form-control"
                                           id="pointsToRedeem" />

                                    <small class="text-muted">
                                        Every 100 points = 50 EGP discount.
                                        Minimum redemption is 100 points.
                                    </small>

                                </div>

                                <div class="col-md-6">

                                    <div class="alert alert-success mb-0">
                                        <div class="d-flex justify-content-between">
                                            <span>Discount</span>

                                            <strong>
                                                <span id="discountAmount">0.00</span>
                                                EGP
                                            </strong>
                                        </div>
                                    </div>

                                </div>

                        <!-- Identification -->
                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="PassportNumber" class="form-label">
                                    Passport Number
                                </label>

                                <input asp-for="PassportNumber"
                                       class="form-control"
                                       dir="ltr" />

                                <span asp-validation-for="PassportNumber"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="NationalID" class="form-label">
                                    National ID
                                </label>

                                <input asp-for="NationalID"
                                       class="form-control"
                                       dir="ltr"
                                       maxlength="14"
                                       inputmode="numeric" />

                                <span asp-validation-for="NationalID"
                                      class="text-danger"></span>
                            </div>

                        </div>

                        <!-- Contact Information -->
                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="Phone" class="form-label">
                                    Phone Number
                                </label>

                                <input asp-for="Phone"
                                       class="form-control"
                                       dir="ltr"
                                       maxlength="11"
                                       inputmode="numeric"
                                       oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 11)" />

                                <span asp-validation-for="Phone"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label">
                                    Email Address
                                </label>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       dir="ltr" />

                                <span asp-validation-for="Email"
                                      class="text-danger"></span>
                            </div>

                        </div>

                        <hr />

                        <div class="d-flex justify-content-between align-items-center">

                            <h5 class="fw-bold mb-0">
                                Final Total
                            </h5>

                            <h4 class="fw-bold text-success mb-0">
                                <span id="finalTotal">
                                    @subtotal.ToString("N2")
                                </span>
                                EGP
                            </h4>

                        </div>

                        <div class="mt-4 text-end">

                            <button type="submit"
                                    class="btn btn-success btn-lg">
                                Continue to Booking
                            </button>

                        </div>

                    </div>
                </div>
            }
        </form>
    </div>
}
                        <!-- Date of Birth -->
                        <div class="mb-4">
                            <label asp-for="DateOfBirth" class="form-label">
                                Date of Birth
                            </label>

                            <input asp-for="DateOfBirth"
                                   type="date"
                                   class="form-control"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")" />

                            <span asp-validation-for="DateOfBirth"
                                  class="text-danger"></span>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-2 flex-wrap">

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-1"></i>
                                Save Passenger
                            </button>

                            <a asp-area="Admin"
                               asp-controller="Passenger"
                               asp-action="Index"
                               class="btn btn-light border">
                                <i class="bi bi-x-circle me-1"></i>
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/passenger-create.js"
            asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const pointsInput =
                document.getElementById("pointsToRedeem");

            const availablePointsElement =
                document.getElementById("availablePoints");

            const subtotalElement =
                document.getElementById("subtotal");

            const discountElement =
                document.getElementById("discountAmount");

            const totalElement =
                document.getElementById("finalTotal");

            // Check that all required elements exist.
            if (
                !(pointsInput instanceof HTMLInputElement) ||
                !availablePointsElement ||
                !subtotalElement ||
                !discountElement ||
                !totalElement
            ) {
                return;
            }

            const availablePoints =
                parseInt(
                    availablePointsElement.textContent || "0",
                    10
                ) || 0;

            const subtotal =
                parseFloat(
                    (subtotalElement.textContent || "0").replace(/,/g, "")
                ) || 0;

            pointsInput.addEventListener("input", function () {

                let points =
                    parseInt(pointsInput.value, 10) || 0;

                if (points < 0) {
                    points = 0;
                }

                if (points > availablePoints) {
                    points = availablePoints;
                }

                // Only multiples of 100 are accepted.
                points = Math.floor(points / 100) * 100;

                // Prevent discount from exceeding subtotal.
                const maximumPointsForPrice =
                    Math.floor(subtotal / 50) * 100;

                if (points > maximumPointsForPrice) {
                    points = maximumPointsForPrice;
                }

                pointsInput.value = points.toString();

                const discount =
                    (points / 100) * 50;

                const finalTotal =
                    subtotal - discount;

                discountElement.textContent =
                    discount.toFixed(2);

                totalElement.textContent =
                    finalTotal.toFixed(2);
            });

        });
    </script>
}
}

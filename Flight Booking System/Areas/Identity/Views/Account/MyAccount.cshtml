@model Flight_Booking_System.Areas.Identity.ViewModels.MyAccountViewModel

@{
    ViewData["Title"] = "My Account";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header">
            <h4>
                <i class="bi bi-person-circle"></i>
                My Account
            </h4>
        </div>

        <div class="card-body">

            <div class="mb-3">
                <label class="form-label">First Name</label>
                <input class="form-control" value="@Model.FirstName" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Middle Name</label>
                <input class="form-control" value="@Model.MiddleName" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Last Name</label>
                <input class="form-control" value="@Model.LastName" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input class="form-control" value="@Model.Email" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Phone Number</label>
                <input class="form-control" value="@Model.PhoneNumber" readonly />
            </div>

            <hr />

            <!-- Reward Points -->

            <div class="card border-success mt-4">

                <div class="card-body text-center">

                    <h5 class="text-success">
                        <i class="bi bi-gift"></i>
                        My Reward Points
                    </h5>

                    <h1 class="display-4 fw-bold text-success">
                        @Model.AvailablePoints
                    </h1>

                    <p class="text-muted mb-2">
                        Available Points
                    </p>

                    <div class="alert alert-light mb-0">
                        <i class="bi bi-info-circle"></i>
                        Every 100 points = 50 EGP discount.
                    </div>

                </div>

            </div>

        </div>
    </div>
</div>

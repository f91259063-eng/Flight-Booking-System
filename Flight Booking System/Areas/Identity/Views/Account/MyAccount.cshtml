@model Flight_Booking_System.Areas.Identity.ViewModels.MyAccountViewModel

@{
    ViewData["Title"] = "My Account";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header">
            <h4><i class="bi bi-person-circle"></i> My Account</h4>
        </div>

        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">First Name</label>
                <input class="form-control" value="@Model.FirstName" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Middle Name</label>
                <input class="form-control" value="@Model.MiddleName" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Last Name</label>
                <input class="form-control" value="@Model.LastName" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input class="form-control" value="@Model.Email" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Phone Number</label>
                <input class="form-control" value="@Model.PhoneNumber" readonly />
            </div>
        </div>
    </div>
</div>

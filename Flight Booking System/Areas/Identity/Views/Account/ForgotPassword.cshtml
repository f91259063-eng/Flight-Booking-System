@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    ViewData["Tagline"] = "Forgot your password? It happens. We'll help you get back in.";
}

<partial name="_AuthSide" />

<div class="col-md-7 d-flex flex-center">
    <div class="p-4 p-md-5 flex-grow-1">
        <h3>Forgot your password?</h3>
        <p class="fs--1">Enter your email and we'll send you a link to reset it.</p>

        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email address</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger fs--1"></span>
            </div>
            <button class="btn btn-primary d-block w-100" type="submit">Send reset link</button>
        </form>

        <p class="fs--1 mt-3 mb-0"><a asp-action="Login">Back to login</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

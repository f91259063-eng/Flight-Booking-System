@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    ViewData["Tagline"] = "Create an account to book flights and earn reward points.";
}

<partial name="_AuthSide" />

<div class="col-md-7 d-flex flex-center">
    <div class="p-4 p-md-5 flex-grow-1">
        <h3>Register</h3>

        <form asp-area="Identity" asp-controller="Account" asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row gx-2">
                <div class="mb-3 col-sm-4">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger fs--1"></span>
                </div>
                <div class="mb-3 col-sm-4">
                    <label asp-for="MiddleName" class="form-label"></label>
                    <input asp-for="MiddleName" class="form-control" />
                    <span asp-validation-for="MiddleName" class="text-danger fs--1"></span>
                </div>
                <div class="mb-3 col-sm-4">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger fs--1"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email address</label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger fs--1"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger fs--1"></span>
            </div>

            <div class="row gx-2">
                <div class="mb-3 col-sm-6">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger fs--1"></span>
                </div>
                <div class="mb-3 col-sm-6">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger fs--1"></span>
                </div>
            </div>

            <div class="mb-3">
                <button class="btn btn-primary d-block w-100 mt-3" type="submit">Register</button>
            </div>
        </form>

        <p class="fs--1 mb-0">Already have an account? <a asp-action="Login">Log in</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model string[]
@{
    ViewData["Title"] = "Recovery codes";
}

<div class="row g-3">
    <div class="col-lg-3"><partial name="_ManageNav" /></div>
    <div class="col-lg-9">
        <div class="card">
            <div class="card-header bg-light"><h5 class="mb-0">Recovery codes</h5></div>
            <div class="card-body">
                <div class="alert alert-warning fs--1">
                    Save these codes somewhere safe. Each one can be used once if you lose your phone.
                    <strong>They are shown only now.</strong>
                </div>

                <div class="row">
                    @foreach (var code in Model)
                    {
                        <div class="col-sm-6 mb-2"><code class="fs-0">@code</code></div>
                    }
                </div>

                <a class="btn btn-primary mt-3" asp-action="TwoFactor">Done</a>
            </div>
        </div>
    </div>
</div>

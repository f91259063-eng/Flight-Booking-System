
@model Flight_Booking_System.ViewModels.Customer.FlightDetailsViewModel

@{
    ViewData["Title"] = "Flight Details";
    Layout = "~/Areas/Customer/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                Flight Details
            </h3>

            <p class="text-600 mb-0">
                Flight @Model.FlightNumber
            </p>
        </div>

        <a asp-area="Customer"
           asp-controller="Flights"
           asp-action="Index"
           class="btn btn-falcon-default">

            <i class="fas fa-arrow-left me-2"></i>
            Back to Flights

        </a>

    </div>


    <!-- ========================================================= -->
    <!-- Flight Information -->
    <!-- ========================================================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">

            <h5 class="mb-0">
                <i class="fas fa-plane me-2 text-primary"></i>
                Flight Information
            </h5>

        </div>


        <div class="card-body">

            <div class="row align-items-center g-4">

                <!-- Departure -->
                <div class="col-md-5">

                    <div class="text-600 fs-9 mb-2">
                        FROM
                    </div>

                    <h4 class="fw-bold mb-2">
                        @Model.DepartureAirport
                    </h4>

                    <div class="fw-bold">
                        @Model.DepartureDateTime.ToString("dd MMM yyyy")
                    </div>

                    <div class="text-primary fw-bold fs-8">
                        @Model.DepartureDateTime.ToString("hh:mm tt")
                    </div>

                </div>


                <!-- Route -->
                <div class="col-md-2 text-center">

                    <i class="fas fa-plane text-primary fa-2x"></i>

                    <div class="border-top border-2 border-dashed my-3"></div>

                    <div class="text-600 fs-9">
                        @Model.Distance.ToString("N0") km
                    </div>

                </div>


                <!-- Arrival -->
                <div class="col-md-5">

                    <div class="text-600 fs-9 mb-2">
                        TO
                    </div>

                    <h4 class="fw-bold mb-2">
                        @Model.ArrivalAirport
                    </h4>

                    <div class="fw-bold">
                        @Model.ArrivalDateTime.ToString("dd MMM yyyy")
                    </div>

                    <div class="text-primary fw-bold fs-8">
                        @Model.ArrivalDateTime.ToString("hh:mm tt")
                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <!-- Airline & Aircraft -->
            <div class="row g-4">

                <!-- Airline -->
                <div class="col-md-6">

                    <div class="d-flex align-items-center">

                        <div class="text-primary me-3">
                            <i class="fas fa-building fa-lg"></i>
                        </div>

                        <div>

                            <div class="text-600 fs-9">
                                Airline
                            </div>

                            <div class="fw-bold">
                                @Model.AirlineName
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Aircraft -->
                <div class="col-md-6">

                    <div class="d-flex align-items-center">

                        <div class="text-primary me-3">
                            <i class="fas fa-plane fa-lg"></i>
                        </div>

                        <div>

                            <div class="text-600 fs-9">
                                Aircraft
                            </div>

                            <div class="fw-bold">
                                @Model.AircraftName
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- Choose Class -->
    <!-- ========================================================= -->

    <div class="card shadow-sm">

        <div class="card-header">

            <h5 class="mb-1">
                <i class="fas fa-chair me-2 text-primary"></i>
                Choose Your Class
            </h5>

            <p class="text-600 fs-9 mb-0">
                Select a class to continue and choose your seat.
            </p>

        </div>


        <div class="card-body">

            @if (Model.Classes == null || !Model.Classes.Any())
            {
                <div class="alert alert-warning mb-0">

                    <i class="fas fa-exclamation-triangle me-2"></i>

                    No classes are available for this aircraft.

                </div>
            }
            else
            {
                <div class="row g-4">

                    @foreach (var item in Model.Classes)
                    {
                        <div class="col-12 col-md-6 col-xl-4">

                            <div class="card h-100 border shadow-sm">

                                <div class="card-body text-center d-flex flex-column">

                                    <!-- Class Icon -->
                                    <div class="mb-3">

                                        <div class="avatar avatar-4xl">

                                            <div class="avatar-name rounded-circle bg-primary-subtle text-primary">

                                                <span>
                                                    <i class="fas fa-chair fa-lg"></i>
                                                </span>

                                            </div>

                                        </div>

                                    </div>


                                    <!-- Class Name -->
                                    <h4 class="fw-bold mb-3">
                                        @item.ClassName
                                    </h4>


                                    <!-- Price Multiplier -->
                                    <div class="mb-3">

                                        <span class="text-600 fs-9 d-block">
                                            Price Multiplier
                                        </span>

                                        <div class="fw-bold">
                                            @item.DistancePercentage.ToString("0.##")
                                        </div>

                                    </div>


                                    <!-- Available Seats -->
                                    <div class="mb-3">

                                        <span class="text-600 fs-9 d-block">
                                            Available Seats
                                        </span>

                                        @if (item.AvailableSeats > 0)
                                        {
                                            <div class="fw-bold text-success">
                                                @item.AvailableSeats
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="fw-bold text-danger">
                                                No Seats
                                            </div>
                                        }

                                    </div>


                                    <!-- Ticket Price -->
                                    <div class="mb-4">

                                        <span class="text-600 fs-9 d-block">
                                            Total Ticket Price
                                        </span>

                                        <div class="fw-bold text-primary fs-5">

                                            @item.TicketPrice.ToString("N2")

                                            <span class="fs-9">
                                                EGP
                                            </span>

                                        </div>

                                    </div>


                                    <!-- Choose Seat -->
                                    <div class="mt-auto">

                                        @if (item.AvailableSeats > 0)
                                        {
                                            <a asp-area="Customer"
                                               asp-controller="Flights"
                                               asp-action="ChooseSeat"
                                               asp-route-flightId="@Model.FlightId"
                                               asp-route-classId="@item.ClassId"
                                               class="btn btn-primary w-100">

                                                <i class="fas fa-chair me-2"></i>

                                                Choose Seat

                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-secondary w-100"
                                                    disabled>

                                                <i class="fas fa-ban me-2"></i>

                                                No Seats Available

                                            </button>
                                        }

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>

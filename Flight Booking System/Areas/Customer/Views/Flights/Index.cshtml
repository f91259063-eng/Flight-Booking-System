@model IEnumerable<Flight_Booking_System.ViewModels.Customer.AvailableFlightViewModel>

@{
    ViewData["Title"] = "Available Flights";
    Layout = "~/Areas/Customer/Views/Shared/_CustomerLayout.cshtml";

    var flights = Model?.ToList()
        ?? new List<Flight_Booking_System.ViewModels.Customer.AvailableFlightViewModel>();

    var departureAirport = Context.Request.Query["departureAirport"].ToString();
    var arrivalAirport = Context.Request.Query["arrivalAirport"].ToString();
    var departureDate = Context.Request.Query["departureDate"].ToString();
}

<div class="container-fluid py-2">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h4 class="mb-1 fw-bold">Available Flights</h4>
            <small class="text-muted">
                Find your flight and explore the details.
            </small>
        </div>

        <span class="badge bg-primary rounded-pill px-3 py-2">
            Total Flights: @flights.Count
        </span>
    </div>

    <!-- Flight Search -->
    <div class="card shadow-sm mb-3">
        <div class="card-body p-3">

            <form asp-area="Customer"
                  asp-controller="Flights"
                  asp-action="Index"
                  method="get">

                <div class="row g-2 align-items-end">

                    <div class="col-12 col-md-4">
                        <label for="departureAirport"
                               class="form-label small fw-semibold">
                            Departure Airport
                        </label>

                        <input type="text"
                               id="departureAirport"
                               name="departureAirport"
                               value="@departureAirport"
                               class="form-control form-control-sm"
                               placeholder="Enter departure airport" />
                    </div>

                    <div class="col-12 col-md-4">
                        <label for="arrivalAirport"
                               class="form-label small fw-semibold">
                            Arrival Airport
                        </label>

                        <input type="text"
                               id="arrivalAirport"
                               name="arrivalAirport"
                               value="@arrivalAirport"
                               class="form-control form-control-sm"
                               placeholder="Enter arrival airport" />
                    </div>

                    <div class="col-12 col-md-2">
                        <label for="departureDate"
                               class="form-label small fw-semibold">
                            Departure Date
                        </label>

                        <input type="date"
                               id="departureDate"
                               name="departureDate"
                               value="@departureDate"
                               class="form-control form-control-sm" />
                    </div>

                    <div class="col-12 col-md-2 d-flex gap-2">
                        <button type="submit"
                                class="btn btn-sm btn-primary flex-grow-1">
                            <i class="fas fa-search me-1"></i>
                            Search
                        </button>

                        <a asp-area="Customer"
                           asp-controller="Flights"
                           asp-action="Index"
                           class="btn btn-sm btn-outline-secondary"
                           title="Clear Search">
                            <i class="fas fa-times"></i>
                        </a>
                    </div>

                </div>
            </form>

        </div>
    </div>

    <!-- Flight Results -->
    @if (!flights.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-4">
                <i class="fas fa-plane fa-2x text-muted mb-2"></i>

                <h6 class="mb-2">No Flights Found</h6>

                <p class="text-muted small mb-3">
                    No upcoming flights match your search.
                    Try changing the airport or departure date.
                </p>

                <a asp-area="Customer"
                   asp-controller="Flights"
                   asp-action="Index"
                   class="btn btn-sm btn-outline-primary">
                    <i class="fas fa-redo me-1"></i>
                    Show All Flights
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-2">

            @foreach (var flight in flights)
            {
                <div class="col-12 col-lg-6 col-xxl-4">

                    <div class="card h-100 shadow-sm">

                        <!-- Compact Header -->
                        <div class="card-header py-2 px-3 bg-body-tertiary">
                            <div class="d-flex justify-content-between align-items-center gap-2">

                                <div class="overflow-hidden">
                                    <div class="fw-bold">
                                        <i class="fas fa-plane-departure text-primary me-1"></i>
                                        @flight.FlightNumber
                                    </div>

                                    <small class="text-muted">
                                        @flight.AirlineName
                                    </small>
                                </div>

                                <span class="badge bg-success">
                                    Available
                                </span>

                            </div>
                        </div>

                        <!-- Compact Body -->
                        <div class="card-body p-3">

                            <div class="row align-items-center g-2">

                                <!-- Departure -->
                                <div class="col-5">
                                    <small class="text-muted d-block mb-1">
                                        FROM
                                    </small>

                                    <div class="fw-bold text-break">
                                        @flight.DepartureAirport
                                    </div>

                                    <div class="small text-muted mt-2">
                                        Departure
                                    </div>

                                    <div class="small fw-semibold">
                                        @flight.DepartureDateTime.ToString("dd MMM yyyy")
                                    </div>

                                    <div class="small text-primary fw-bold">
                                        @flight.DepartureDateTime.ToString("hh:mm tt")
                                    </div>
                                </div>

                                <!-- Route -->
                                <div class="col-2 text-center">
                                    <small class="text-muted d-block mb-2">
                                        ROUTE
                                    </small>

                                    <i class="fas fa-plane text-primary"></i>

                                    <div class="border-top border-2 border-dashed my-2"></div>

                                    <small class="text-muted text-nowrap">
                                        @flight.Distance.ToString("N0") km
                                    </small>
                                </div>

                                <!-- Arrival -->
                                <div class="col-5">
                                    <small class="text-muted d-block mb-1">
                                        TO
                                    </small>

                                    <div class="fw-bold text-break">
                                        @flight.ArrivalAirport
                                    </div>

                                    <div class="small text-muted mt-2">
                                        Arrival
                                    </div>

                                    <div class="small fw-semibold">
                                        @flight.ArrivalDateTime.ToString("dd MMM yyyy")
                                    </div>

                                    <div class="small text-primary fw-bold">
                                        @flight.ArrivalDateTime.ToString("hh:mm tt")
                                    </div>
                                </div>

                            </div>

                            <hr class="my-3" />

                            <!-- Aircraft Information -->
                            <div class="row g-2">

                                <div class="col-7">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fas fa-plane text-primary"></i>

                                        <div class="overflow-hidden">
                                            <small class="text-muted d-block">
                                                Aircraft
                                            </small>

                                            <div class="small fw-semibold text-break">
                                                @flight.AircraftName
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-5">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fas fa-calendar-alt text-primary"></i>

                                        <div>
                                            <small class="text-muted d-block">
                                                Day
                                            </small>

                                            <div class="small fw-semibold">
                                                @flight.DepartureDateTime.ToString("dddd")
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <!-- Flight Details Button -->
                            <div class="text-end mt-3">
                                <a asp-area="Customer"
                                   asp-controller="Flights"
                                   asp-action="Details"
                                   asp-route-id="@flight.FlightId"
                                   class="btn btn-sm btn-primary">

                                    <i class="fas fa-info-circle me-1"></i>
                                    Flight Details
                                </a>
                            </div>

                        </div>
                    </div>

                </div>
            }

        </div>
    }

</div>

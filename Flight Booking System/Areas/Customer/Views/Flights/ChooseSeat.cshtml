```razor
@model Flight_Booking_System.ViewModels.Customer.ChooseSeatViewModel

@{
    ViewData["Title"] = "Choose Seat";
    Layout = "~/Areas/Customer/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                Choose Your Seat
            </h3>

            <p class="text-600 mb-0">
                Flight @Model.FlightNumber
            </p>
        </div>

        <a asp-area="Customer"
           asp-controller="Flights"
           asp-action="Details"
           asp-route-id="@Model.FlightId"
           class="btn btn-falcon-default">

            <i class="fas fa-arrow-left me-2"></i>
            Back to Flight

        </a>

    </div>


    <!-- Flight Information -->
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-4">

                    <div class="text-600 fs-9">
                        FLIGHT
                    </div>

                    <div class="fw-bold">
                        @Model.FlightNumber
                    </div>

                </div>


                <div class="col-md-4">

                    <div class="text-600 fs-9">
                        AIRCRAFT
                    </div>

                    <div class="fw-bold">
                        @Model.AircraftName
                    </div>

                </div>


                <div class="col-md-4">

                    <div class="text-600 fs-9">
                        CLASS
                    </div>

                    <div class="fw-bold">
                        @Model.ClassName
                    </div>

                </div>

            </div>


            <hr />


            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <span class="text-600 fs-9">
                        Ticket Price
                    </span>

                    <div class="fw-bold text-primary fs-5">
                        @Model.TicketPrice.ToString("N2") EGP
                    </div>
                </div>

                <div>
                    <span class="badge bg-primary">
                        @Model.Seats.Count Seats
                    </span>
                </div>

            </div>

        </div>

    </div>


    <!-- Seats -->
    <div class="card shadow-sm">

        <div class="card-header">

            <h5 class="mb-1">
                <i class="fas fa-chair me-2 text-primary"></i>
                Choose Your Seat
            </h5>

            <p class="text-600 fs-9 mb-0">
                Select one available seat.
            </p>

        </div>


        <div class="card-body">

            @if (Model.Seats == null || !Model.Seats.Any())
            {
                <div class="alert alert-warning text-center">

                    <i class="fas fa-exclamation-triangle me-2"></i>

                    No seats are available for this class.

                </div>
            }
            else
            {
                <div class="row g-3">

                    @foreach (var seat in Model.Seats)
                    {
                        <div class="col-6 col-sm-4 col-md-3 col-lg-2">

                            @if (seat.IsAvailable)
                            {
                                <button type="button"
                                        class="btn btn-outline-primary w-100 py-3">

                                    <i class="fas fa-chair d-block mb-2"></i>

                                    <span class="fw-bold">
                                        @seat.SeatNumber
                                    </span>

                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-secondary w-100 py-3"
                                        disabled>

                                    <i class="fas fa-chair d-block mb-2"></i>

                                    <span>
                                        @seat.SeatNumber
                                    </span>

                                </button>
                            }

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>

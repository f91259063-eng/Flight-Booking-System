@model IEnumerable<Flight_Booking_System.ViewModels.Customer.MyBookingViewModel>

@{
    ViewData["Title"] = "My Bookings";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">My Bookings</h2>
        <p class="text-muted mb-0">
            Manage your reservations and payment details.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center py-5">
                <i class="fas fa-plane fa-3x text-muted mb-3"></i>

                <h5 class="fw-bold">No bookings yet</h5>

                <p class="text-muted mb-0">
                    You don't have any bookings yet.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var b in Model)
            {
                <div class="col-12">

                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                        <!-- Booking Header -->
                        <div class="card-header bg-white border-bottom p-3 p-md-4">

                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                                <div>
                                    <span class="text-muted small">
                                        Booking Reference
                                    </span>

                                    <h5 class="fw-bold mb-0">
                                        @b.BookingReference
                                    </h5>
                                </div>

                                <div class="d-flex flex-wrap gap-2">

                                    @if (b.Status == "Confirmed")
                                    {
                                        <span class="badge bg-success-subtle text-success px-3 py-2">
                                            Confirmed
                                        </span>
                                    }
                                    else if (b.Status == "Pending")
                                    {
                                        <span class="badge bg-warning-subtle text-warning px-3 py-2">
                                            Pending
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary px-3 py-2">
                                            @b.Status
                                        </span>
                                    }

                                    @if (b.PaymentStatus)
                                    {
                                        <span class="badge bg-success-subtle text-success px-3 py-2">
                                            <i class="fas fa-check-circle me-1"></i>
                                            Paid
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger px-3 py-2">
                                            <i class="fas fa-exclamation-circle me-1"></i>
                                            Unpaid
                                        </span>
                                    }

                                </div>

                            </div>
                        </div>

                        <!-- Booking Details -->
                        <div class="card-body p-3 p-md-4">

                            <div class="row g-4 align-items-center">

                                <!-- Flight Information -->
                                <div class="col-lg-7">

                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <i class="fas fa-plane text-primary"></i>

                                        <span class="fw-semibold">
                                            Flight @b.FlightNumber
                                        </span>
                                    </div>

                                    <div class="row align-items-center">

                                        <div class="col-5">
                                            <h5 class="fw-bold mb-1">
                                                @b.DepartureAirport
                                            </h5>

                                            <div class="small text-muted">
                                                @if (b.DepartureDateTime != default)
                                                {
                                                    @b.DepartureDateTime.ToString("dd MMM yyyy")
                                                    <br />
                                                    @b.DepartureDateTime.ToString("hh:mm tt")
                                                }
                                                else
                                                {
                                                    <span>Not available</span>
                                                }
                                            </div>
                                        </div>

                                        <div class="col-2 text-center">
                                            <i class="fas fa-plane text-primary"></i>
                                            <hr class="my-2" />
                                        </div>

                                        <div class="col-5 text-end">
                                            <h5 class="fw-bold mb-1">
                                                @b.ArrivalAirport
                                            </h5>

                                            <div class="small text-muted">
                                                @if (b.ArrivalDateTime != default)
                                                {
                                                    @b.ArrivalDateTime.ToString("dd MMM yyyy")
                                                    <br />
                                                    @b.ArrivalDateTime.ToString("hh:mm tt")
                                                }
                                                else
                                                {
                                                    <span>Not available</span>
                                                }
                                            </div>
                                        </div>

                                    </div>

                                </div>

                                <!-- Payment Information -->
                                <div class="col-lg-5">

                                    <div class="bg-light rounded-3 p-3">

                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted">
                                                Booking Date
                                            </span>

                                            <span class="fw-semibold">
                                                @b.BookingDate.ToString("dd MMM yyyy")
                                            </span>
                                        </div>

                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted">
                                                Number of Tickets
                                            </span>

                                            <span class="fw-semibold">
                                                @b.NumberOfTickets
                                            </span>
                                        </div>

                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted">
                                                Total Price
                                            </span>

                                            <span class="fw-bold">
                                                @b.TotalPrice.ToString("N2") EGP
                                            </span>
                                        </div>

                                        @if (!b.PaymentStatus && b.PaymentAmount > 0)
                                        {
                                            <div class="d-flex justify-content-between mb-2">
                                                <span class="text-muted">
                                                    Amount Due
                                                </span>

                                                <span class="fw-bold text-danger">
                                                    @b.PaymentAmount.ToString("N2") EGP
                                                </span>
                                            </div>
                                        }

                                        <hr />

                                        @if (b.CanPay)
                                        {
                                            <a asp-area="Customer"
                                               asp-controller="Payment"
                                               asp-action="Checkout"
                                               asp-route-bookingId="@b.BookingId"
                                               class="btn btn-primary w-100 rounded-3">

                                                <i class="fas fa-credit-card me-2"></i>
                                                Pay Now
                                            </a>
                                        }
                                        else if (b.PaymentStatus)
                                        {
                                            <div class="text-center text-success fw-semibold">
                                                <i class="fas fa-check-circle me-1"></i>
                                                Payment Completed
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-center text-muted small">
                                                Payment is not available.
                                            </div>
                                        }

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>

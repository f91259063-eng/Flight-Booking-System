
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@(ViewData["Title"] ?? "Customer Portal") | Flight Booking System</title>

    <link rel="icon"
          type="image/png"
          href="~/assets/img/favicons/favicon-32x32.png" />

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/vendors/fontawesome/all.min.css" />

    <!-- Customer Theme -->
    <link rel="stylesheet" href="~/css/customer/customer-theme.css" asp-append-version="true" />

    <!-- Customer Layout -->
    <link rel="stylesheet" href="~/css/customer/customer-layout.css" asp-append-version="true" />

    <!-- Customer Components -->
    <link rel="stylesheet" href="~/css/customer/customer-components.css" asp-append-version="true" />

    <!-- Customer Dashboard -->
    <link rel="stylesheet" href="~/css/customer/customer-dashboard.css" asp-append-version="true" />

    <!-- Customer Responsive -->
    <link rel="stylesheet" href="~/css/customer/customer-responsive.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="customer-app">

    <div class="customer-shell">

        <!-- =========================
             Sidebar
        ========================== -->

        <aside class="customer-sidebar"
               data-customer-sidebar
               aria-label="Customer navigation">

            <!-- Brand -->
            <a class="customer-brand"
               asp-area="Customer"
               asp-controller="Home"
               asp-action="Index">

                <span class="customer-brand-mark">
                    <i class="fas fa-plane-departure"></i>
                </span>

                <span>
                    <span class="customer-brand-name">Flight Booking</span>
                    <span class="customer-brand-caption">Customer Portal</span>
                </span>

            </a>

            <!-- Navigation -->
            <div class="customer-sidebar-scroll">

                <!-- Dashboard -->
                <div class="customer-nav-group">

                    <div class="customer-nav-heading">
                        Dashboard
                    </div>

                    <a class="customer-nav-link"
                       asp-area="Customer"
                       asp-controller="Home"
                       asp-action="Index">

                        <i class="fas fa-home"></i>
                        <span>Home</span>

                    </a>

                </div>

                <!-- Flights -->
                <div class="customer-nav-group">

                    <div class="customer-nav-heading">
                        Flight Management
                    </div>

                    <a class="customer-nav-link"
                       asp-area="Customer"
                       asp-controller="Flights"
                       asp-action="Index">

                        <i class="fas fa-plane-departure"></i>
                        <span>Available Flights</span>

                    </a>

                </div>

                <!-- Bookings -->
                <div class="customer-nav-group">

                    <div class="customer-nav-heading">
                        Booking Management
                    </div>

                    <a class="customer-nav-link"
                       asp-area="Customer"
                       asp-controller="Booking"
                       asp-action="Index">

                        <i class="fas fa-ticket-alt"></i>
                        <span>My Bookings</span>

                    </a>

                    <a class="customer-nav-link"
                       asp-area="Customer"
                       asp-controller="Tickets"
                       asp-action="Index">

                        <i class="fas fa-receipt"></i>
                        <span>My Tickets</span>

                    </a>

                </div>

                <!-- Account -->
                <div class="customer-nav-group">

                    <div class="customer-nav-heading">
                        Account Management
                    </div>

                    <a class="customer-nav-link"
                       asp-area="Identity"
                       asp-controller="Account"
                       asp-action="MyAccount">

                        <i class="fas fa-user-circle"></i>
                        <span>My Account</span>

                    </a>

                </div>

            </div>

            <!-- Sidebar Bottom -->
            <div class="customer-sidebar-bottom">

                <div class="customer-sidebar-version">
                    Flight Booking System · Customer Portal
                </div>

            </div>

        </aside>

        <!-- Sidebar Overlay -->
        <div class="customer-sidebar-overlay"
             data-customer-sidebar-overlay>
        </div>

        <!-- =========================
             Main Content
        ========================== -->

        <main class="customer-main">

            <!-- Topbar -->
            <header class="customer-topbar">

                <div class="customer-topbar-start">

                    <!-- Sidebar Toggle -->
                    <button class="customer-menu-toggle"
                            type="button"
                            data-customer-sidebar-toggle
                            aria-label="Toggle navigation"
                            aria-expanded="false">

                        <i class="fas fa-bars"></i>

                    </button>

                    <!-- Page Title -->
                    <h1 class="customer-topbar-title">
                        @((ViewData["Title"] ?? "Customer Dashboard").ToString())
                    </h1>

                </div>

                <div class="customer-topbar-end">

                    <!-- Navigation Search -->
                    <label class="customer-search"
                           aria-label="Search navigation">

                        <i class="fas fa-search"></i>

                        <input type="search"
                               placeholder="Search menu..."
                               data-customer-nav-search />

                    </label>

                    <!-- Available Flights -->
                    <a class="customer-icon-button"
                       asp-area="Customer"
                       asp-controller="Flights"
                       asp-action="Index"
                       title="Available Flights"
                       aria-label="Available Flights">

                        <i class="fas fa-plane"></i>

                    </a>

                    <!-- User Menu -->
                    <div class="dropdown">

                        <button class="btn p-0 border-0 bg-transparent dropdown-toggle customer-user-menu"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">

                            <span class="customer-user-avatar">
                                <i class="fas fa-user"></i>
                            </span>

                            <span class="customer-user-meta">

                                <span class="customer-user-name">
                                    @(User.Identity?.Name ?? "Customer")
                                </span>

                                <span class="customer-user-role">
                                    Customer
                                </span>

                            </span>

                        </button>

                        <div class="dropdown-menu dropdown-menu-end">

                            <!-- My Account -->
                            <a class="dropdown-item"
                               asp-area="Identity"
                               asp-controller="Account"
                               asp-action="MyAccount">

                                <i class="fas fa-user me-2"></i>
                                My Account

                            </a>

                            <!-- My Bookings -->
                            <a class="dropdown-item"
                               asp-area="Customer"
                               asp-controller="Booking"
                               asp-action="Index">

                                <i class="fas fa-ticket-alt me-2"></i>
                                My Bookings

                            </a>

                            <div class="dropdown-divider"></div>

                            <!-- Logout -->
                            <form asp-area="Identity"
                                  asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="dropdown-item text-danger">

                                    <i class="fas fa-sign-out-alt me-2"></i>
                                    Logout

                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            </header>

            <!-- Page Content -->
            <section class="customer-content">

                @RenderBody()

            </section>

            <!-- Footer -->
            <footer class="customer-footer">

                <span>
                    Flight Booking System &copy; @DateTime.Now.Year
                </span>

                <span>
                    Customer Portal
                </span>

            </footer>

        </main>

    </div>

    <!-- Bootstrap JavaScript -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Customer Layout JavaScript -->
    <script src="~/js/customer/customer-layout.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

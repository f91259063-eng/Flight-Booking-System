
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@(ViewData["Title"] ?? "Customer Dashboard") | Flight Booking System</title>

    <link rel="icon"
          type="image/png"
          href="~/assets/img/favicons/favicon-32x32.png" />

    <script src="~/assets/js/config.js"></script>

    <link rel="stylesheet" href="~/vendors/simplebar/simplebar.min.css" />
    <link rel="stylesheet" href="~/assets/css/theme.min.css" />
    <link rel="stylesheet" href="~/assets/css/user.min.css" />
    <link rel="stylesheet" href="~/vendors/fontawesome/all.min.css" />

    <style>
        .navbar-brand-text {
            font-size: 1rem;
            font-weight: 700;
            color: #2c7be5;
            white-space: nowrap;
        }

        .navbar-brand img {
            object-fit: contain;
        }

        .content {
            min-width: 0;
        }

        .sidebar-heading {
            padding: 16px 20px 6px;
            font-size: 11px;
            color: #748194;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .navbar-vertical .nav-link {
            padding-top: .65rem;
            padding-bottom: .65rem;
        }

        .navbar-vertical .nav-link-icon {
            min-width: 1.8rem;
            display: inline-flex;
            justify-content: center;
        }

        .navbar-vertical .nav-link-text {
            white-space: normal;
        }

        .footer {
            margin-top: auto;
        }

        .content > .container-fluid {
            min-height: 70vh;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <main class="main" id="top">
        <div class="container-fluid" data-layout="container">

            <!-- Sidebar -->
            <nav class="navbar navbar-light navbar-vertical navbar-expand-xl">

                <!-- Sidebar Header -->
                <div class="d-flex align-items-center">

                    <div class="toggle-icon-wrapper">
                        <button class="btn navbar-toggler-humburger-icon navbar-vertical-toggle"
                                type="button"
                                data-bs-toggle="tooltip"
                                data-bs-placement="left"
                                title="Toggle Navigation"
                                aria-label="Toggle Navigation">

                            <span class="navbar-toggle-icon">
                                <span class="toggle-line"></span>
                            </span>
                        </button>
                    </div>

                    <!-- Project Logo -->
                    <a class="navbar-brand"
                       asp-area="Customer"
                       asp-controller="Flights"
                       asp-action="Index">

                        <div class="d-flex align-items-center py-3">

                            <img class="me-2"
                                 src="~/falcon/img/apple-touch-icon.png"
                                 alt="Flight Booking System Logo"
                                 width="40"
                                 height="40" />

                            <span class="navbar-brand-text">
                                Flight Booking System
                            </span>

                        </div>
                    </a>
                </div>

                <!-- Sidebar Menu -->
                <div class="collapse navbar-collapse"
                     id="navbarVerticalCollapse">

                    <div class="navbar-vertical-content scrollbar">

                        <ul class="navbar-nav flex-column mb-3"
                            id="customerNavbar">

                            <!-- Customer Dashboard -->
                            <li class="nav-item">

                                <div class="sidebar-heading">
                                    Dashboard
                                </div>

                                <a class="nav-link"
                                   asp-area="Customer"
                                   asp-controller="Home"
                                   asp-action="Index">

                                    <span class="nav-link-icon">
                                        <i class="fas fa-home"></i>
                                    </span>

                                    <span class="nav-link-text ps-1">
                                        Home
                                    </span>
                                </a>
                            </li>

                            <!-- Flight Management -->
                            <li class="nav-item">

                                <div class="sidebar-heading">
                                    Flights
                                </div>

                                <a class="nav-link"
                                   asp-area="Customer"
                                   asp-controller="Flights"
                                   asp-action="Index">

                                    <span class="nav-link-icon">
                                        <i class="fas fa-plane-departure"></i>
                                    </span>

                                    <span class="nav-link-text ps-1">
                                        Available Flights
                                    </span>
                                </a>
                            </li>

                            <!-- Booking Management -->
                            <li class="nav-item">

                                <div class="sidebar-heading">
                                    Booking Management
                                </div>

                                <a class="nav-link"
                                   asp-area="Customer"
                                   asp-controller="Bookings"
                                   asp-action="Index">

                                    <span class="nav-link-icon">
                                        <i class="fas fa-ticket-alt"></i>
                                    </span>

                                    <span class="nav-link-text ps-1">
                                        My Bookings
                                    </span>
                                </a>

                                <a class="nav-link"
                                   asp-area="Customer"
                                   asp-controller="Tickets"
                                   asp-action="Index">

                                    <span class="nav-link-icon">
                                        <i class="fas fa-receipt"></i>
                                    </span>

                                    <span class="nav-link-text ps-1">
                                        My Tickets
                                    </span>
                                </a>
                            </li>

                            <!-- Account Management -->
                            <li class="nav-item">

                                <div class="sidebar-heading">
                                    Account
                                </div>

                                <a class="nav-link"
                                   asp-area="Identity"
                                   asp-page="/Account/Manage/Index">

                                    <span class="nav-link-icon">
                                        <i class="fas fa-user"></i>
                                    </span>

                                    <span class="nav-link-text ps-1">
                                        My Account
                                    </span>
                                </a>
                            </li>

                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Main Content -->
            <div class="content">

                <!-- Top Navbar -->
                <nav class="navbar navbar-light navbar-glass navbar-top navbar-expand">

                    <!-- Mobile Sidebar Toggle -->
                    <button class="btn navbar-toggler-humburger-icon navbar-toggler me-1 me-sm-3"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#navbarVerticalCollapse"
                            aria-controls="navbarVerticalCollapse"
                            aria-expanded="false"
                            aria-label="Toggle Navigation">

                        <span class="navbar-toggle-icon">
                            <span class="toggle-line"></span>
                        </span>
                    </button>

                    <!-- Page Title -->
                    <div class="d-flex align-items-center">
                        <h5 class="mb-0">
                            @(ViewData["Title"] ?? "Customer Dashboard")
                        </h5>
                    </div>

                    <!-- Right Navbar -->
                    <ul class="navbar-nav ms-auto flex-row align-items-center">

                        <!-- Flights Home -->
                        <li class="nav-item">
                            <a class="nav-link px-2"
                               asp-area="Customer"
                               asp-controller="Flights"
                               asp-action="Index"
                               title="Available Flights"
                               aria-label="Available Flights">

                                <i class="fas fa-plane"></i>
                            </a>
                        </li>

                        <!-- User Menu -->
                        <li class="nav-item dropdown">

                            <a class="nav-link pe-0 ps-2"
                               href="#"
                               id="customerUserMenu"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                <div class="avatar avatar-xl">
                                    <div class="avatar-name rounded-circle bg-soft-primary text-primary">
                                        <span>
                                            <i class="fas fa-user"></i>
                                        </span>
                                    </div>
                                </div>
                            </a>

                            <div class="dropdown-menu dropdown-menu-end py-0"
                                 aria-labelledby="customerUserMenu">

                                <div class="bg-white rounded-2 py-2">

                                    <a class="dropdown-item"
                                       asp-area="Identity"
                                       asp-page="/Account/Manage/Index">

                                        <i class="fas fa-user me-2"></i>
                                        My Account
                                    </a>

                                    <div class="dropdown-divider"></div>

                                    <!-- Logout -->
                                    <form asp-area="Identity"
                                          asp-page="/Account/Logout"
                                          asp-route-returnUrl="/Identity/Account/Login"
                                          method="post">

                                        <button type="submit"
                                                class="dropdown-item text-danger">

                                            <i class="fas fa-sign-out-alt me-2"></i>
                                            Logout
                                        </button>
                                    </form>

                                </div>
                            </div>
                        </li>
                    </ul>
                </nav>

                <!-- Page Content -->
                <div class="container-fluid py-3">

                    @RenderBody()

                </div>

                <!-- Footer -->
                <footer class="footer">

                    <div class="row g-0 justify-content-between align-items-center fs--1 mt-4 mb-3">

                        <div class="col-12 col-sm-auto text-center">
                            <p class="mb-0 text-600">
                                Flight Booking System
                                <span class="d-none d-sm-inline-block">|</span>
                                <span class="d-sm-none"><br /></span>
                                &copy; @DateTime.Now.Year
                            </p>
                        </div>

                        <div class="col-12 col-sm-auto text-center">
                            <p class="mb-0 text-600">
                                Customer Portal
                            </p>
                        </div>

                    </div>
                </footer>

            </div>
        </div>
    </main>

    <!-- JavaScript -->
    <script src="~/vendors/popper/popper.min.js"></script>
    <script src="~/vendors/bootstrap/bootstrap.min.js"></script>
    <script src="~/vendors/simplebar/simplebar.min.js"></script>
    <script src="~/vendors/fontawesome/all.min.js"></script>
    <script src="~/assets/js/theme.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

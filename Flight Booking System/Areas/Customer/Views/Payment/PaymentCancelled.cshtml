@{
    ViewData["Title"] = "Payment Cancelled";
    Layout = "~/Areas/Customer/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container py-5 text-center">
    <h2>Payment Cancelled</h2>
    <p>Your booking is still pending payment.</p>
    <p>Booking Reference: @ViewBag.BookingReference</p>

    <a asp-area="Customer"
       asp-controller="Booking"
       asp-action="Index"
       class="btn btn-primary">
        My Bookings
    </a>
</div>
@{
    ViewData["Title"] = "Payment Cancelled";
    Layout = "~/Areas/Customer/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body text-center p-4 p-md-5">

                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning bg-opacity-10"
                             style="width: 90px; height: 90px;">
                            <i class="fas fa-exclamation-circle text-warning"
                               style="font-size: 46px;"></i>
                        </div>
                    </div>

                    <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill mb-3">
                        Payment Cancelled
                    </span>

                    <h2 class="fw-bold mb-3">Your Payment Was Cancelled</h2>

                    <p class="text-muted mb-4">
                        Your payment was not completed. Don't worry,
                        your booking is still pending payment.
                        You can return to your bookings and try again.
                    </p>

                    <div class="bg-light rounded-3 p-3 mb-4">
                        <div class="text-muted small mb-1">
                            Booking Reference
                        </div>

                        <div class="fw-bold fs-5">
                            @ViewBag.BookingReference
                        </div>

                        <div class="small text-warning mt-2">
                            <i class="fas fa-clock me-1"></i>
                            Awaiting Payment
                        </div>
                    </div>

                    <a asp-area="Customer"
                       asp-controller="Booking"
                       asp-action="Index"
                       class="btn btn-primary btn-lg rounded-3 px-4">
                        <i class="fas fa-ticket-alt me-2"></i>
                        My Bookings
                    </a>

                    <div class="mt-4">
                        <small class="text-muted">
                            Need help? Please contact our support team.
                        </small>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

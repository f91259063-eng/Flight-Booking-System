@{
    ViewData["Title"] = "Payment Failed";
    Layout = "~/Areas/Customer/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body text-center p-4 p-md-5">

                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10"
                             style="width: 90px; height: 90px;">
                            <i class="fas fa-times-circle text-danger"
                               style="font-size: 46px;"></i>
                        </div>
                    </div>

                    <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill mb-3">
                        Payment Failed
                    </span>

                    <h2 class="fw-bold mb-3">Payment Not Completed</h2>

                    <p class="text-muted mb-4">
                        We could not confirm your payment.
                        Your booking has not been confirmed.
                        Please return to your bookings and try again.
                    </p>

                    <div class="bg-light rounded-3 p-3 mb-4">
                        <div class="fw-semibold mb-2">
                            <i class="fas fa-info-circle text-danger me-1"></i>
                            Booking Status
                        </div>

                        <span class="badge bg-warning text-dark px-3 py-2">
                            Pending Payment
                        </span>

                        <p class="text-muted small mt-2 mb-0">
                            No successful payment has been recorded.
                        </p>
                    </div>

                    <a asp-area="Customer"
                       asp-controller="Booking"
                       asp-action="Index"
                       class="btn btn-primary btn-lg rounded-3 px-4">
                        <i class="fas fa-ticket-alt me-2"></i>
                        My Bookings
                    </a>

                    <div class="mt-4">
                        <small class="text-muted">
                            If the amount was deducted from your account,
                            please contact our support team.
                        </small>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
